<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agriculture_asset_allocation_list" model="ir.ui.view">
        <field name="name">agriculture.asset.allocation.list</field>
        <field name="model">agriculture.asset.allocation</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="farm_id"/>
                <field name="percentage" widget="percentage"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>
</odoo>
