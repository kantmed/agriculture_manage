<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_form_agriculture_asset" model="ir.ui.view">
        <field name="name">agriculture.farm.form.agriculture.asset</field>
        <field name="model">agriculture.farm</field>
        <field name="inherit_id" ref="agriculture_manage.view_farm_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="analytic_account_id" domain="[('company_id', '=', company_id)]" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
