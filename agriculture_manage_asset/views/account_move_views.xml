<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_agriculture_asset" model="ir.ui.view">
        <field name="name">account.move.form.agriculture.asset</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']" position="after">
                <field name="agriculture_asset_scope" optional="hide"/>
                <field name="agriculture_farm_id" optional="hide" domain="[('company_id', '=', company_id)]"/>
                <field name="agriculture_site_id" optional="hide" domain="[('farm_id', '=', agriculture_farm_id)]"/>
                <field name="agriculture_project_id" optional="hide" domain="[('company_id', '=', company_id)]"/>
                <field name="agriculture_asset_id" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
