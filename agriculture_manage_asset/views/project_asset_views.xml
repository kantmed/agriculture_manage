<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_agriculture_assets" model="ir.ui.view">
        <field name="name">project.project.form.agriculture.asset</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="agriculture_manage_project.view_project_form_agriculture"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Immobilisation issue du projet" name="agriculture_asset">
                    <group>
                        <group>
                            <field name="agriculture_investment_state" readonly="1"/>
                            <field name="agriculture_asset_category_id" readonly="agriculture_investment_state == 'completed'"/>
                            <field name="agriculture_asset_origin" readonly="agriculture_investment_state == 'completed'"/>
                            <field name="agriculture_investment_actual_cost" readonly="agriculture_investment_state == 'completed'"/>
                            <field name="agriculture_currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="agriculture_project_invoice_total" readonly="1"/>
                            <field name="agriculture_project_operation_total" readonly="1"/>
                            <field name="agriculture_asset_id" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="note">
                        Les totaux des factures et des opérations sont des indicateurs séparés. Le coût final immobilisable doit être validé après rapprochement afin d'éviter tout double comptage.
                    </div>
                    <button name="action_create_agriculture_asset" type="object"
                            string="Achever le projet et créer l'immobilisation"
                            class="oe_highlight"
                            invisible="agriculture_investment_state == 'completed' or agriculture_asset_id"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
