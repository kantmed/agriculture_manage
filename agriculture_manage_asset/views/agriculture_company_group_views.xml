<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agriculture_company_group_form" model="ir.ui.view">
        <field name="name">agriculture.company.group.form</field>
        <field name="model">agriculture.company.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_agriculture_company_group_list" model="ir.ui.view">
        <field name="name">agriculture.company.group.list</field>
        <field name="model">agriculture.company.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="action_agriculture_company_group" model="ir.actions.act_window">
        <field name="name">Groupes de sociétés</field>
        <field name="res_model">agriculture.company.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>