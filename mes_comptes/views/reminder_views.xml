<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mes_reminder_list" model="ir.ui.view">
        <field name="name">mes.comptes.reminder.list</field>
        <field name="model">mes.comptes.reminder</field>
        <field name="arch" type="xml">
            <list string="Rappels" decoration-info="not read">
                <field name="date"/>
                <field name="reminder_type"/>
                <field name="message"/>
                <field name="user_id"/>
                <field name="read"/>
            </list>
        </field>
    </record>
    <record id="view_mes_reminder_form" model="ir.ui.view">
        <field name="name">mes.comptes.reminder.form</field>
        <field name="model">mes.comptes.reminder</field>
        <field name="arch" type="xml">
            <form string="Rappel">
                <header>
                    <button name="action_view_record" type="object" string="Voir l'objet concerné" class="btn-primary"/>
                    <button name="action_mark_read" type="object" string="Marquer comme lu" invisible="read"/>
                </header>
                <sheet>
                    <group>
                        <field name="reminder_type"/>
                        <field name="date"/>
                        <field name="message"/>
                        <field name="user_id"/>
                        <field name="read"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_mes_reminders" model="ir.actions.act_window">
        <field name="name">Rappels</field>
        <field name="res_model">mes.comptes.reminder</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>