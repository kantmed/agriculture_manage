<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mes_currency_rate_list" model="ir.ui.view">
        <field name="name">mes.comptes.currency.rate.list</field>
        <field name="model">res.currency.rate</field>
        <field name="arch" type="xml">
            <list string="Historique des taux" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="currency_id"/>
                <field name="company_rate"/>
                <field name="inverse_company_rate"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
    <record id="view_mes_currency_rate_search" model="ir.ui.view">
        <field name="name">mes.comptes.currency.rate.search</field>
        <field name="model">res.currency.rate</field>
        <field name="arch" type="xml">
            <search>
                <field name="currency_id"/>
                <field name="name"/>
                <separator/>
                <filter name="group_company" string="Société" domain="[('company_id', '=', current_company_id)]"/>
                <filter name="group_all" string="Toutes les sociétés" domain="[]"/>
            </search>
        </field>
    </record>
    <record id="action_mes_currency_rates" model="ir.actions.act_window">
        <field name="name">Historique des taux</field>
        <field name="res_model">res.currency.rate</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_mes_currency_rate_list"/>
        <field name="search_view_id" ref="view_mes_currency_rate_search"/>
    </record>
</odoo>