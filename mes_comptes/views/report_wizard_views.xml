<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mes_financial_report_wizard" model="ir.ui.view">
        <field name="name">mes.comptes.report.wizard.form</field>
        <field name="model">mes.comptes.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Rapport financier">
                <group>
                    <field name="date_start"/>
                    <field name="date_end"/>
                </group>
                <footer>
                    <button name="action_preview_report" type="object" string="Aperçu HTML" class="btn-secondary"/>
                    <button name="action_print_report" type="object" string="Imprimer PDF" class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_mes_financial_report_wizard" model="ir.actions.act_window">
        <field name="name">Rapport financier PDF</field>
        <field name="res_model">mes.comptes.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mes_financial_report_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
