<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mes_account_list" model="ir.ui.view">
        <field name="name">mes.comptes.account.list</field><field name="model">mes.comptes.account</field>
        <field name="arch" type="xml">
            <list string="Mes comptes"><field name="name"/><field name="account_type"/><field name="currency_id"/><field name="opening_balance"/><field name="current_balance"/><field name="active"/></list>
        </field>
    </record>
    <record id="view_mes_account_form" model="ir.ui.view">
        <field name="name">mes.comptes.account.form</field><field name="model">mes.comptes.account</field>
        <field name="arch" type="xml">
            <form string="Compte">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Ex. Compte courant"/></h1></div>
                    <group><group><field name="account_type"/><field name="code"/><field name="currency_id"/></group>
                    <group><field name="opening_balance"/><field name="current_balance" readonly="1"/><field name="active"/></group></group>
                    <group><field name="user_ids" widget="many2many_tags"/></group>
                    <group><field name="note"/></group>
                    <field name="user_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_mes_accounts" model="ir.actions.act_window">
        <field name="name">Mes comptes</field><field name="res_model">mes.comptes.account</field><field name="view_mode">list,form</field>
    </record>
</odoo>