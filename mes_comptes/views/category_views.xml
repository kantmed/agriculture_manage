<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mes_category_list" model="ir.ui.view">
        <field name="name">mes.comptes.category.list</field><field name="model">mes.comptes.category</field>
        <field name="arch" type="xml"><list string="Catégories"><field name="name"/><field name="transaction_type"/><field name="active"/></list></field>
    </record>
    <record id="view_mes_category_form" model="ir.ui.view">
        <field name="name">mes.comptes.category.form</field><field name="model">mes.comptes.category</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="transaction_type"/><field name="active"/></group></sheet></form></field>
    </record>
    <record id="action_mes_categories" model="ir.actions.act_window">
        <field name="name">Catégories</field><field name="res_model">mes.comptes.category</field><field name="view_mode">list,form</field>
    </record>
</odoo>
