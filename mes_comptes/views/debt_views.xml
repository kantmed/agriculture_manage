<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mes_debt_list" model="ir.ui.view">
        <field name="name">mes.comptes.debt.list</field><field name="model">mes.comptes.debt</field>
        <field name="arch" type="xml">
            <list string="Dettes et créances" decoration-danger="is_due_soon">
                <field name="name"/><field name="debt_type"/><field name="partner_name"/><field name="date"/><field name="due_date"/><field name="amount"/><field name="paid_amount"/><field name="remaining_amount"/><field name="state"/><field name="is_due_soon"/>
            </list>
        </field>
    </record>
    <record id="view_mes_debt_search" model="ir.ui.view">
        <field name="name">mes.comptes.debt.search</field>
        <field name="model">mes.comptes.debt</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_name"/>
                <field name="due_date"/>
                <separator/>
                <filter name="group_open" string="En cours" domain="[('state', '=', 'open')]"/>
                <filter name="group_paid" string="Soldées" domain="[('state', '=', 'paid')]"/>
                <filter name="group_cancel" string="Annulées" domain="[('state', '=', 'cancel')]"/>
                <filter name="group_due_soon" string="Échéance approchante" domain="[('is_due_soon', '=', True)]"/>
            </search>
        </field>
    </record>
    <record id="view_mes_debt_form" model="ir.ui.view">
        <field name="name">mes.comptes.debt.form</field><field name="model">mes.comptes.debt</field>
        <field name="arch" type="xml">
            <form string="Dette / créance"><sheet><div class="oe_title"><h1><field name="name"/></h1></div>
                <group><group><field name="debt_type"/><field name="partner_name"/><field name="date"/><field name="due_date"/><field name="reminder_days"/><field name="account_id"/></group>
                <group><field name="amount"/><field name="paid_amount"/><field name="remaining_amount"/><field name="state"/><field name="is_due_soon"/></group></group>
                <notebook><page string="Règlements"><field name="payment_ids"><list editable="bottom"><field name="date"/><field name="amount"/><field name="account_id"/><field name="state"/><button name="action_post" type="object" string="Valider" invisible="state != 'draft'"/></list></field></page><page string="Notes"><field name="note"/></page></notebook><field name="user_id" invisible="1"/>
            </sheet></form>
        </field>
    </record>
    <record id="action_mes_debts" model="ir.actions.act_window">
        <field name="name">Dettes et créances</field><field name="res_model">mes.comptes.debt</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mes_debt_search"/>
    </record>
</odoo>