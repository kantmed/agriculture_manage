<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mes_budget_list" model="ir.ui.view">
        <field name="name">mes.comptes.budget.list</field><field name="model">mes.comptes.budget</field>
        <field name="arch" type="xml">
            <list string="Budgets" decoration-danger="is_overdraft" decoration-warning="usage_percent &gt;= 80">
                <field name="name"/><field name="category_id"/><field name="date_start"/><field name="date_end"/><field name="currency_id"/><field name="planned_amount"/><field name="spent_amount"/><field name="remaining_amount"/><field name="usage_percent"/><field name="is_overdraft"/>
            </list>
        </field>
    </record>
    <record id="view_mes_budget_search" model="ir.ui.view">
        <field name="name">mes.comptes.budget.search</field>
        <field name="model">mes.comptes.budget</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <separator/>
                <filter name="group_active" string="Actifs" domain="[('active', '=', True)]"/>
                <filter name="group_overdraft" string="Dépassés" domain="[('is_overdraft', '=', True)]"/>
            </search>
        </field>
    </record>
    <record id="view_mes_budget_form" model="ir.ui.view">
        <field name="name">mes.comptes.budget.form</field><field name="model">mes.comptes.budget</field>
        <field name="arch" type="xml">
            <form string="Budget"><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="category_id"/><field name="date_start"/><field name="date_end"/></group><group><field name="currency_id"/><field name="planned_amount"/><field name="spent_amount" readonly="1"/><field name="remaining_amount" readonly="1"/><field name="usage_percent" widget="percentage" readonly="1"/><field name="is_overdraft" readonly="1"/></group></group><field name="user_id" invisible="1"/></sheet></form></field>
    </record>
    <record id="action_mes_budgets" model="ir.actions.act_window">
        <field name="name">Budgets</field><field name="res_model">mes.comptes.budget</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mes_budget_search"/>
    </record>
</odoo>