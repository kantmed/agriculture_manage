<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="plot_list" name="Parcelles">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="d-flex justify-content-between mb-3">
                    <h2>Parcelles agricoles</h2>
                    <a href="/my/agriculture/plots/new" class="btn btn-primary">Nouvelle parcelle</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Exploitation</th>
                                <th>Superficie</th>
                                <th>État</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="plots" t-as="plot">
                                <td><a t-att-href="'/my/agriculture/plots/%s' % plot.id" t-out="plot.name"/></td>
                                <td t-out="plot.farm_id.name"/>
                                <td t-out="plot.area"/>
                                <td t-out="plot.state"/>
                                <td>
                                    <a t-att-href="'/my/agriculture/plots/%s' % plot.id" class="btn btn-sm btn-outline-primary">Consulter</a>
                                </td>
                            </tr>
                            <tr t-if="not plots">
                                <td colspan="5" class="text-center">Aucune parcelle trouvée.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <a href="/my/agriculture" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>

    <template id="plot_form" name="Formulaire parcelle">
        <t t-call="portal.portal_layout">
            <div class="o_form_view">
                <form method="post" t-att-action="'/my/agriculture/plots/%s/update' % plot.id if plot else '/my/agriculture/plots/create'">
                    <div class="o_form_sheet_bg">
                        <div class="o_form_sheet">
                            <div class="oe_title">
                                <h1><input type="text" name="name" class="form-control" placeholder="Nom de la parcelle" required="required" t-att-value="values.get('name') if values else (plot.name if plot else '')"/></h1>
                            </div>
                            <div class="o_group">
                                <table class="o_group_table">
                                    <tr>
                                        <td class="o_td_label"><label>Exploitation</label></td>
                                        <td>
                                            <select name="farm_id" class="form-select">
                                                <t t-foreach="farms" t-as="farm" t-key="farm.id">
                                                    <option t-att-value="farm.id" t-att-selected="'selected' if (values.get('farm_id') if values else (plot.farm_id.id if plot else None)) == farm.id else None" t-out="farm.name"/>
                                                </t>
                                            </select>
                                        </td>
                                        <td class="o_td_label"><label>Superficie</label></td>
                                        <td><input type="number" step="0.01" name="area" class="form-control" t-att-value="values.get('area') if values else (plot.area if plot else 0)"/></td>
                                    </tr>
                                    <tr>
                                        <td class="o_td_label"><label>Unité</label></td>
                                        <td>
                                            <select name="area_unit" class="form-select">
                                                <option value="ha">ha</option>
                                                <option value="m2">m²</option>
                                            </select>
                                        </td>
                                        <td class="o_td_label"><label>État</label></td>
                                        <td>
                                            <select name="state" class="form-select">
                                                <option value="available">Disponible</option>
                                                <option value="cultivated">En culture</option>
                                            </select>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="o_form_buttons mt-3">
                                <button type="submit" class="btn btn-primary">Enregistrer</button>
                                <a href="/my/agriculture/plots" class="btn btn-secondary">Annuler</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="plot_detail" name="Détail parcelle">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2 t-out="plot.name"/>
                <p>Exploitation : <span t-out="plot.farm_id.name"/></p>
                <p>Superficie : <span t-out="plot.area"/> <span t-out="plot.area_unit"/></p>
                <p>État : <span t-out="plot.state"/></p>
                <a t-att-href="'/my/agriculture/plots/%s/edit' % plot.id" class="btn btn-secondary">Modifier</a>
                <form t-att-action="'/my/agriculture/plots/%s/delete' % plot.id" method="post" style="display:inline">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button type="submit" class="btn btn-danger">Supprimer</button>
                </form>
                <a href="/my/agriculture/plots" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>
</odoo>