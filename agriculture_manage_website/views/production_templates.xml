<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="production_list" name="Productions">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="d-flex justify-content-between mb-3">
                    <h2>Productions animales</h2>
                    <a href="/my/agriculture/productions/new" class="btn btn-primary">Nouvelle production</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Animal/Lot</th>
                                <th>Quantité</th>
                                <th>État</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="records" t-as="rec" t-key="rec.id">
                                <td><a t-att-href="'/my/agriculture/productions/%s' % rec.id" t-out="rec.name"/></td>
                                <td t-out="rec.production_type"/>
                                <td t-out="rec.date"/>
                                <td t-out="rec.animal_id.name or rec.herd_id.name"/>
                                <td><span t-out="rec.quantity"/> <span t-out="rec.uom_id.name"/></td>
                                <td t-out="rec.state"/>
                                <td>
                                    <a t-att-href="'/my/agriculture/productions/%s' % rec.id" class="btn btn-sm btn-outline-primary">Consulter</a>
                                </td>
                            </tr>
                            <tr t-if="not records">
                                <td colspan="7" class="text-center">Aucune production trouvée.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <a href="/my/agriculture" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>

    <template id="production_form" name="Formulaire production">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2>Nouvelle production</h2>
                <form method="post" action="/my/agriculture/productions/create">
                    <div class="card"><div class="card-body">
                        <div class="mb-3">
                            <label>Type</label>
                            <select name="production_type" class="form-select">
                                <option value="milk">Lait</option>
                                <option value="eggs">Œufs</option>
                                <option value="wool">Laine</option>
                                <option value="honey">Miel</option>
                                <option value="meat">Viande</option>
                                <option value="other">Autre</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label>Animal</label>
                            <select name="animal_id" class="form-select">
                                <option value="">--</option>
                                <t t-foreach="animals" t-as="a" t-key="a.id">
                                    <option t-att-value="a.id" t-out="a.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label>Lot</label>
                            <select name="herd_id" class="form-select">
                                <option value="">--</option>
                                <t t-foreach="herds" t-as="h" t-key="h.id">
                                    <option t-att-value="h.id" t-out="h.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label>Date</label>
                            <input type="date" name="date" class="form-control"/>
                        </div>
                        <div class="mb-3">
                            <label>Quantité</label>
                            <input type="number" step="0.01" name="quantity" class="form-control" required="required"/>
                        </div>
                        <div class="mb-3">
                            <label>Unité</label>
                            <select name="uom_id" class="form-select">
                                <option value="">--</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label>Qualité</label>
                            <select name="quality" class="form-select">
                                <option value="standard">Standard</option>
                                <option value="good">Bonne</option>
                                <option value="premium">Premium</option>
                                <option value="rejected">Non conforme</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label>Produit / variété</label>
                            <input type="text" name="product_description" class="form-control"/>
                        </div>
                        <div class="mb-3">
                            <label>Notes</label>
                            <textarea name="notes" class="form-control"/>
                        </div>
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                        <a href="/my/agriculture/productions" class="btn btn-secondary">Annuler</a>
                    </div></div>
                </form>
            </div>
        </t>
    </template>

    <template id="production_detail" name="Détail production">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2 t-out="record.name"/>
                <p>Type : <span t-out="record.production_type"/></p>
                <p>Date : <span t-out="record.date"/></p>
                <p>Animal : <span t-out="record.animal_id.name"/></p>
                <p>Lot : <span t-out="record.herd_id.name"/></p>
                <p>Quantité : <span t-out="record.quantity"/> <span t-out="record.uom_id.name"/></p>
                <p>Qualité : <span t-out="record.quality"/></p>
                <p>État : <span t-out="record.state"/></p>
                <form t-att-action="'/my/agriculture/productions/%s/delete' % record.id" method="post" style="display:inline">
                    <button type="submit" class="btn btn-danger">Supprimer</button>
                </form>
                <a href="/my/agriculture/productions" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>
</odoo>