<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Liste des exploitations -->
    <template id="farm_list" name="Mes exploitations">
        <t t-call="portal.portal_layout">
            <div class="container py-4">

                <div class="d-flex justify-content-between mb-4">
                    <h2>Mes exploitations agricoles</h2>
                    <a href="/my/agriculture/farms/new"
                       class="btn btn-primary">
                        Nouvelle exploitation
                    </a>
                </div>

                <form method="get" action="/my/agriculture/farms"
                      class="mb-3">
                    <div class="input-group">
                        <input type="search" name="search"
                               class="form-control"
                               placeholder="Nom ou référence"
                               t-att-value="search"/>
                        <button class="btn btn-outline-primary">
                            Rechercher
                        </button>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Référence</th>
                                <th>Ville</th>
                                <th>Superficie (ha)</th>
                                <th>État</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="farms" t-as="farm">
                                <td><t t-out="farm.name"/></td>
                                <td><t t-out="farm.code or '-'"/></td>
                                <td><t t-out="farm.city or '-'"/></td>
                                <td><t t-out="farm.total_area"/></td>
                                <td>
                                    <span t-if="farm.active"
                                          class="badge bg-success">
                                        Active
                                    </span>
                                    <span t-else=""
                                          class="badge bg-secondary">
                                        Archivée
                                    </span>
                                </td>
                                <td>
                                    <a t-att-href="'/my/agriculture/farms/%s' % farm.id"
                                       class="btn btn-sm btn-outline-primary">
                                        Consulter
                                    </a>
                                </td>
                            </tr>
                            <tr t-if="not farms">
                                <td colspan="6" class="text-center">
                                    Aucune exploitation trouvée.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <!-- Formulaire création / modification -->
    <template id="farm_form" name="Formulaire exploitation">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <h2 t-if="farm">Modifier l'exploitation</h2>
                <h2 t-else="">Nouvelle exploitation</h2>

                <div t-if="error" class="alert alert-danger"
                     role="alert">
                    <t t-out="error"/>
                </div>

                <form method="post"
                      t-att-action="('/my/agriculture/farms/%s/update' % farm.id) if farm else '/my/agriculture/farms/create'">

                    <input type="hidden" name="csrf_token"
                           t-att-value="request.csrf_token()"/>

                    <div class="row g-3">

                        <div class="col-md-8">
                            <label class="form-label">
                                Nom de l'exploitation *
                            </label>
                            <input type="text" name="name"
                                   required="required"
                                   class="form-control"
                                   t-att-value="values.get('name', farm.name if farm else '')"/>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Référence</label>
                            <input type="text" name="code"
                                   class="form-control"
                                   t-att-value="values.get('code', farm.code if farm else '')"/>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Téléphone</label>
                            <input type="text" name="phone"
                                   class="form-control"
                                   t-att-value="values.get('phone', farm.phone if farm else '')"/>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">E-mail</label>
                            <input type="email" name="email"
                                   class="form-control"
                                   t-att-value="values.get('email', farm.email if farm else '')"/>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Adresse</label>
                            <input type="text" name="street"
                                   class="form-control"
                                   t-att-value="values.get('street', farm.street if farm else '')"/>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Ville / Commune</label>
                            <input type="text" name="city"
                                   class="form-control"
                                   t-att-value="values.get('city', farm.city if farm else '')"/>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Superficie totale (ha)</label>
                            <input type="number" name="total_area"
                                   min="0" step="0.01"
                                   class="form-control"
                                   t-att-value="values.get('total_area', farm.total_area if farm else 0)"/>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Pays</label>
                            <select name="country_id" class="form-select">
                                <option value="">Sélectionner</option>
                                <option t-foreach="countries" t-as="country"
                                        t-att-value="country.id"
                                        t-att-selected="str(values.get('country_id', farm.country_id.id if farm else '')) == str(country.id)">
                                    <t t-out="country.name"/>
                                </option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Wilaya</label>
                            <select name="state_id" class="form-select">
                                <option value="">Sélectionner</option>
                                <option t-foreach="states" t-as="state"
                                        t-att-value="state.id"
                                        t-att-selected="str(values.get('state_id', farm.state_id.id if farm else '')) == str(state.id)">
                                    <t t-out="state.name"/>
                                </option>
                            </select>
                        </div>

                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            Enregistrer
                        </button>
                        <a href="/my/agriculture/farms"
                           class="btn btn-secondary">
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <!-- Fiche détaillée -->
    <template id="farm_detail" name="Fiche exploitation">
        <t t-call="portal.portal_layout">
            <div class="container py-4">

                <div class="d-flex justify-content-between mb-4">
                    <h2><t t-out="farm.name"/></h2>
                    <div>
                        <a t-att-href="'/my/agriculture/farms/%s/edit' % farm.id"
                           class="btn btn-primary">
                            Modifier
                        </a>
                        <a href="/my/agriculture/farms"
                           class="btn btn-secondary">
                            Retour
                        </a>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <strong>Référence :</strong>
                                <t t-out="farm.code or '-'"/>
                            </div>
                            <div class="col-md-6">
                                <strong>Superficie :</strong>
                                <t t-out="farm.total_area"/> ha
                            </div>
                            <div class="col-md-6">
                                <strong>Téléphone :</strong>
                                <t t-out="farm.phone or '-'"/>
                            </div>
                            <div class="col-md-6">
                                <strong>E-mail :</strong>
                                <t t-out="farm.email or '-'"/>
                            </div>
                            <div class="col-md-6">
                                <strong>Adresse :</strong>
                                <t t-out="farm.street or '-'"/>
                            </div>
                            <div class="col-md-6">
                                <strong>Ville :</strong>
                                <t t-out="farm.city or '-'"/>
                            </div>
                            <div class="col-md-6">
                                <strong>Wilaya :</strong>
                                <t t-out="farm.state_id.name or '-'"/>
                            </div>
                            <div class="col-md-6">
                                <strong>Pays :</strong>
                                <t t-out="farm.country_id.name or '-'"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mt-4">
                    <div class="card-body">
                        <h4>Sites et parcelles</h4>
                        <p>
                            Sites : <t t-out="len(farm.site_ids)"/>
                            -
                            Parcelles : <t t-out="len(farm.plot_ids)"/>
                        </p>
                    </div>
                </div>

                <form method="post"
                      t-att-action="'/my/agriculture/farms/%s/delete' % farm.id"
                      class="mt-4"
                      onsubmit="return confirm('Confirmer la suppression de cette exploitation ?');">
                    <input type="hidden" name="csrf_token"
                           t-att-value="request.csrf_token()"/>
                    <button type="submit" class="btn btn-outline-danger">
                        Supprimer
                    </button>
                </form>

            </div>
        </t>
    </template>

</odoo>
