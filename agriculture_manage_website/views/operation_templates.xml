<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="operation_list" name="Opérations">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2>Opérations culturales</h2>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Campagne</th>
                                <th>Parcelle</th>
                                <th>État</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="operations" t-as="operation" t-key="operation.id">
                                <td><a t-att-href="'/my/agriculture/operations/%s' % operation.id" t-out="operation.code"/></td>
                                <td t-out="operation.operation_type"/>
                                <td t-out="operation.date"/>
                                <td t-out="operation.campaign_id.name"/>
                                <td t-out="operation.plot_id.name"/>
                                <td t-out="operation.state"/>
                                <td>
                                    <a t-att-href="'/my/agriculture/operations/%s' % operation.id" class="btn btn-sm btn-outline-primary">Consulter</a>
                                </td>
                            </tr>
                            <tr t-if="not operations">
                                <td colspan="7" class="text-center">Aucune opération trouvée.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <a href="/my/agriculture" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>

    <template id="operation_detail" name="Détail opération">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2 t-out="operation.name"/>
                <p>Référence : <span t-out="operation.code"/></p>
                <p>Type : <span t-out="operation.operation_type"/></p>
                <p>Date : <span t-out="operation.date"/></p>
                <p>Campagne : <span t-out="operation.campaign_id.name"/></p>
                <p>Parcelle : <span t-out="operation.plot_id.name"/></p>
                <p>État : <span t-out="operation.state"/></p>
                <a href="/my/agriculture/operations" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>
</odoo>