<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="finance_list" name="Finance">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2>Comptes financiers agricoles</h2>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>Nom</th>
                                <th>Type</th>
                                <th>Devise</th>
                                <th>Solde</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="accounts" t-as="account" t-key="account.id">
                                <td><a t-att-href="'/my/agriculture/finance/%s' % account.id" t-out="account.code"/></td>
                                <td t-out="account.name"/>
                                <td t-out="account.account_type"/>
                                <td t-out="account.currency_id.name"/>
                                <td t-out="account.balance"/>
                                <td>
                                    <a t-att-href="'/my/agriculture/finance/%s' % account.id" class="btn btn-sm btn-outline-primary">Consulter</a>
                                </td>
                            </tr>
                            <tr t-if="not accounts">
                                <td colspan="6" class="text-center">Aucun compte trouvé.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <a href="/my/agriculture" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>

    <template id="finance_detail" name="Détail compte financier">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2 t-out="account.name"/>
                <p>Référence : <span t-out="account.code"/></p>
                <p>Type : <span t-out="account.account_type"/></p>
                <p>Devise : <span t-out="account.currency_id.name"/></p>
                <p>Solde : <span t-out="account.balance"/></p>
                <a href="/my/agriculture/finance" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>

    <template id="transaction_list" name="Transactions financières">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2>Mouvements financiers agricoles</h2>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>Libellé</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Montant</th>
                                <th>Compte</th>
                                <th>État</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="transactions" t-as="tx" t-key="tx.id">
                                <td><a t-att-href="'/my/agriculture/finance/transactions/%s' % tx.id" t-out="tx.reference or tx.id"/></td>
                                <td t-out="tx.name"/>
                                <td t-out="tx.transaction_type"/>
                                <td t-out="tx.date"/>
                                <td t-out="tx.amount"/>
                                <td t-out="tx.account_id.name"/>
                                <td t-out="tx.state"/>
                                <td>
                                    <a t-att-href="'/my/agriculture/finance/transactions/%s' % tx.id" class="btn btn-sm btn-outline-primary">Consulter</a>
                                </td>
                            </tr>
                            <tr t-if="not transactions">
                                <td colspan="8" class="text-center">Aucun mouvement trouvé.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <a href="/my/agriculture/finance" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>

    <template id="transaction_detail" name="Détail mouvement financier">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2 t-out="transaction.name"/>
                <p>Libellé : <span t-out="transaction.name"/></p>
                <p>Type : <span t-out="transaction.transaction_type"/></p>
                <p>Date : <span t-out="transaction.date"/></p>
                <p>Montant : <span t-out="transaction.amount"/> <span t-out="transaction.currency_id.name"/></p>
                <p>Compte : <span t-out="transaction.account_id.name"/></p>
                <p>État : <span t-out="transaction.state"/></p>
                <p>Référence : <span t-out="transaction.reference"/></p>
                <a href="/my/agriculture/finance/transactions" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>
</odoo>