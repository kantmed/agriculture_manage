<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="harvest_list" name="Récoltes">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2>Récoltes agricoles</h2>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>Campagne</th>
                                <th>Parcelle</th>
                                <th>Date</th>
                                <th>Quantité</th>
                                <th>Qualité</th>
                                <th>État</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="harvests" t-as="harvest" t-key="harvest.id">
                                <td><a t-att-href="'/my/agriculture/harvests/%s' % harvest.id" t-out="harvest.code"/></td>
                                <td t-out="harvest.campaign_id.name"/>
                                <td t-out="harvest.plot_id.name"/>
                                <td t-out="harvest.harvest_date"/>
                                <td><span t-out="harvest.quantity"/> <span t-out="harvest.uom_id.name"/></td>
                                <td t-out="harvest.quality"/>
                                <td t-out="harvest.state"/>
                                <td>
                                    <a t-att-href="'/my/agriculture/harvests/%s' % harvest.id" class="btn btn-sm btn-outline-primary">Consulter</a>
                                </td>
                            </tr>
                            <tr t-if="not harvests">
                                <td colspan="8" class="text-center">Aucune récolte trouvée.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <a href="/my/agriculture" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>

    <template id="harvest_detail" name="Détail récolte">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2 t-out="harvest.name"/>
                <p>Référence : <span t-out="harvest.code"/></p>
                <p>Campagne : <span t-out="harvest.campaign_id.name"/></p>
                <p>Parcelle : <span t-out="harvest.plot_id.name"/></p>
                <p>Date : <span t-out="harvest.harvest_date"/></p>
                <p>Quantité : <span t-out="harvest.quantity"/> <span t-out="harvest.uom_id.name"/></p>
                <p>Qualité : <span t-out="harvest.quality"/></p>
                <p>État : <span t-out="harvest.state"/></p>
                <a href="/my/agriculture/harvests" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>
</odoo>