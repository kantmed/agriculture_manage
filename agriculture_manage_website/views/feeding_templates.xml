<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="feeding_list" name="Rations">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="d-flex justify-content-between mb-3">
                    <h2>Rations alimentaires</h2>
                    <a href="/my/agriculture/feeding/new" class="btn btn-primary">Nouvelle ration</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Exploitation</th>
                                <th>Espèce</th>
                                <th>Objectif</th>
                                <th>Énergie (kcal/tête)</th>
                                <th>Protéines (g/tête)</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="rations" t-as="ration" t-key="ration.id">
                                <td><a t-att-href="'/my/agriculture/feeding/%s' % ration.id" t-out="ration.name"/></td>
                                <td t-out="ration.farm_id.name"/>
                                <td t-out="ration.species_id.name"/>
                                <td t-out="ration.purpose"/>
                                <td t-out="ration.total_energy_per_head"/>
                                <td t-out="ration.total_protein_per_head"/>
                                <td>
                                    <a t-att-href="'/my/agriculture/feeding/%s' % ration.id" class="btn btn-sm btn-outline-primary">Consulter</a>
                                </td>
                            </tr>
                            <tr t-if="not rations">
                                <td colspan="7" class="text-center">Aucune ration trouvée.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <a href="/my/agriculture" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>

    <template id="feeding_form" name="Formulaire ration">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2>Nouvelle ration</h2>
                <form method="post" action="/my/agriculture/feeding/create">
                    <div class="card"><div class="card-body">
                        <div class="mb-3">
                            <label>Nom</label>
                            <input type="text" name="name" class="form-control" required="required" t-att-value="values.get('name') if values else ''"/>
                        </div>
                        <div class="mb-3">
                            <label>Exploitation</label>
                            <select name="farm_id" class="form-select">
                                <t t-foreach="farms" t-as="farm" t-key="farm.id">
                                    <option t-att-value="farm.id" t-out="farm.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label>Espèce</label>
                            <select name="species_id" class="form-select">
                                <t t-foreach="species" t-as="sp" t-key="sp.id">
                                    <option t-att-value="sp.id" t-out="sp.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label>Objectif</label>
                            <select name="purpose" class="form-select">
                                <option value="meat">Viande</option>
                                <option value="milk">Lait</option>
                                <option value="breeding">Reproduction</option>
                                <option value="fattening">Engraissement</option>
                                <option value="eggs">Œufs</option>
                                <option value="wool">Laine</option>
                                <option value="other">Autres</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label>Notes</label>
                            <textarea name="notes" class="form-control"/>
                        </div>
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                        <a href="/my/agriculture/feeding" class="btn btn-secondary">Annuler</a>
                    </div></div>
                </form>
            </div>
        </t>
    </template>

    <template id="feeding_detail" name="Détail ration">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2 t-out="ration.name"/>
                <p>Exploitation : <span t-out="ration.farm_id.name"/></p>
                <p>Espèce : <span t-out="ration.species_id.name"/></p>
                <p>Objectif : <span t-out="ration.purpose"/></p>
                <p>Énergie totale par tête : <span t-out="ration.total_energy_per_head"/> kcal</p>
                <p>Protéines totales par tête : <span t-out="ration.total_protein_per_head"/> g</p>
                <a href="/my/agriculture/feeding" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>
</odoo>