<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="campaign_list" name="Campagnes">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="d-flex justify-content-between mb-3">
                    <h2>Campagnes agricoles</h2>
                    <a href="/my/agriculture/campaigns/new" class="btn btn-primary">Nouvelle campagne</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Exploitation</th>
                                <th>Culture</th>
                                <th>Période</th>
                                <th>État</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="campaigns" t-as="campaign" t-key="campaign.id">
                                <td><a t-att-href="'/my/agriculture/campaigns/%s' % campaign.id" t-out="campaign.name"/></td>
                                <td t-out="campaign.farm_id.name"/>
                                <td t-out="campaign.crop_id.name"/>
                                <td><span t-out="campaign.start_date"/> — <span t-out="campaign.end_date"/></td>
                                <td t-out="campaign.state"/>
                                <td>
                                    <a t-att-href="'/my/agriculture/campaigns/%s' % campaign.id" class="btn btn-sm btn-outline-primary">Consulter</a>
                                </td>
                            </tr>
                            <tr t-if="not campaigns">
                                <td colspan="6" class="text-center">Aucune campagne trouvée.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <a href="/my/agriculture" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>

    <template id="campaign_form" name="Formulaire campagne">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2 t-if="not campaign">Nouvelle campagne</h2>
                <h2 t-if="campaign">Modifier la campagne</h2>
                <form t-att-action="'/my/agriculture/campaigns/%s/update' % campaign.id if campaign else '/my/agriculture/campaigns/create'" method="post">
                    <div class="oe_title mb-3">
                        <label for="name">Nom</label>
                        <h1><input type="text" name="name" class="form-control" placeholder="Nom de la campagne" t-att-value="values.get('name') if values else (campaign.name if campaign else '')"/></h1>
                    </div>
                    <div class="mb-3">
                        <label>Code</label>
                        <input type="text" name="code" class="form-control" readonly="readonly" t-att-value="values.get('code') if values else (campaign.code if campaign else '')"/>
                    </div>
                    <div class="mb-3">
                        <label>Exploitation</label>
                        <select name="farm_id" class="form-control">
                            <t t-foreach="farms" t-as="farm" t-key="farm.id">
                                <option t-att-value="farm.id" t-att-selected="'selected' if (values.get('farm_id') if values else (campaign.farm_id.id if campaign else None)) == farm.id else None" t-out="farm.name"/>
                            </t>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Culture</label>
                        <select name="crop_id" class="form-control">
                            <t t-foreach="crops" t-as="crop" t-key="crop.id">
                                <option t-att-value="crop.id" t-att-selected="'selected' if (values.get('crop_id') if values else (campaign.crop_id.id if campaign else None)) == crop.id else None" t-out="crop.name"/>
                            </t>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Variété</label>
                        <select name="variety_id" class="form-control">
                            <option value="">--</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Date de début</label>
                        <input type="date" name="start_date" class="form-control" t-att-value="values.get('start_date') if values else (campaign.start_date if campaign else '')"/>
                    </div>
                    <div class="mb-3">
                        <label>Date de fin</label>
                        <input type="date" name="end_date" class="form-control" t-att-value="values.get('end_date') if values else (campaign.end_date if campaign else '')"/>
                    </div>
                    <div class="mb-3">
                        <label>État</label>
                        <select name="state" class="form-control">
                            <option value="draft">Brouillon</option>
                            <option value="active">En cours</option>
                            <option value="done">Terminée</option>
                            <option value="cancelled">Annulée</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Observations</label>
                        <textarea name="notes" class="form-control" t-out="values.get('notes') if values else (campaign.notes if campaign else '')"/>
                    </div>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                    <a href="/my/agriculture/campaigns" class="btn btn-secondary">Annuler</a>
                </form>
            </div>
        </t>
    </template>

    <template id="campaign_detail" name="Détail campagne">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2 t-out="campaign.name"/>
                <p>Exploitation : <span t-out="campaign.farm_id.name"/></p>
                <p>Culture : <span t-out="campaign.crop_id.name"/></p>
                <p>Période : <span t-out="campaign.start_date"/> — <span t-out="campaign.end_date"/></p>
                <p>État : <span t-out="campaign.state"/></p>
                <div t-out="campaign.notes"/>
                <a t-att-href="'/my/agriculture/campaigns/%s/edit' % campaign.id" class="btn btn-secondary">Modifier</a>
                <form t-att-action="'/my/agriculture/campaigns/%s/delete' % campaign.id" method="post" style="display:inline">
                    <button type="submit" class="btn btn-danger">Supprimer</button>
                </form>
                <a href="/my/agriculture/campaigns" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>
</odoo>