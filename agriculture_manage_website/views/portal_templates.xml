<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_dashboard"
              name="Agriculture Portal Dashboard">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2>Agriculture Management</h2>
                <p>Bienvenue dans votre espace agricole.</p>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5>Exploitations</h5>
                                <p>Gestion des exploitations agricoles.</p>
                                <a href="/my/agriculture/farms" class="btn btn-primary">
                                    Consulter
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5>Sites agricoles</h5>
                                <p>Gestion des sites de production, stockage, élevage et serres.</p>
                                <a href="/my/agriculture/sites" class="btn btn-primary">
                                    Consulter
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5>Parcelles</h5>
                                <p>Gestion des parcelles agricoles.</p>
                                <a href="/my/agriculture/plots" class="btn btn-primary">
                                    Consulter
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5>Infrastructures</h5>
                                <p>Gestion des bâtiments, entrepôts, puits, réservoirs et équipements fixes.</p>
                                <a href="/my/agriculture/infrastructures" class="btn btn-primary">
                                    Consulter
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5>Maintenance</h5>
                                <p>Consulter les équipements agricoles et l'historique des interventions.</p>
                                <a href="/my/agriculture/maintenance/equipment" class="btn btn-primary">Consulter les équipements</a>
                                <a href="/my/agriculture/maintenance/requests" class="btn btn-outline-primary mt-2">Interventions</a>
                                <a href="/my/agriculture/maintenance/requests/new" class="btn btn-outline-secondary mt-2">Déclarer une intervention</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5>Activités</h5>
                                <p>Suivi des activités agricoles.</p>
                                <a href="/my/agriculture/activities" class="btn btn-primary">
                                    Consulter
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5>Campagnes</h5>
                                <p>Gestion des campagnes culturales.</p>
                                <a href="/my/agriculture/campaigns" class="btn btn-primary">
                                    Consulter
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5>Opérations</h5>
                                <p>Suivi des opérations culturales.</p>
                                <a href="/my/agriculture/operations" class="btn btn-primary">
                                    Consulter
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5>Récoltes</h5>
                                <p>Suivi des récoltes agricoles.</p>
                                <a href="/my/agriculture/harvests" class="btn btn-primary">
                                    Consulter
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5>Élevage</h5>
                                <p>Suivi du cheptel.</p>
                                <a href="/my/agriculture/livestock" class="btn btn-primary">
                                    Consulter
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5>Finance</h5>
                                <p>Comptes financiers agricoles.</p>
                                <a href="/my/agriculture/finance" class="btn btn-primary">
                                    Consulter
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5>Budgets</h5>
                                <p>Budgets agricoles.</p>
                                <a href="/my/agriculture/budgets" class="btn btn-primary">
                                    Consulter
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

    <template id="portal_plots" name="Parcelles">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2>Parcelles agricoles</h2>
                <ul>
                    <t t-foreach="plots" t-as="plot" t-key="plot.id">
                        <li t-out="plot.name"/>
                    </t>
                </ul>
                <a href="/my/agriculture" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>

    <template id="portal_activities" name="Activités">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2>Types d'activité</h2>
                <ul>
                    <t t-foreach="activities" t-as="activity" t-key="activity.id">
                        <li t-out="activity.name"/>
                    </t>
                </ul>
                <a href="/my/agriculture" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>
</odoo>
