<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="site_list" name="Sites agricoles">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>Sites agricoles</h2>
                    <a href="/my/agriculture/sites/new" class="btn btn-primary">Nouveau site</a>
                </div>
                <div class="card"><div class="card-body"><div class="card"><div class="card-body"><form method="get" action="/my/agriculture/sites" class="mb-3">
                    <div class="input-group">
                        <input type="search" name="search" class="form-control"
                               placeholder="Nom du site ou exploitation" t-att-value="search"/>
                        <button class="btn btn-outline-primary" type="submit">Rechercher</button>
                    </div>
                </form></div></div></div></div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Site</th><th>Référence</th><th>Exploitation</th>
                                <th>Type</th><th>Commune</th><th>Parcelles</th><th>État</th><th/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="sites" t-as="site">
                                <td t-out="site.name"/>
                                <td t-out="site.code or '-'"/>
                                <td t-out="site.farm_id.name"/>
                                <td t-out="site_type_labels.get(site.site_type, site.site_type)"/>
                                <td t-out="site.city or '-'"/>
                                <td t-out="site.plot_count"/>
                                <td>
                                    <span t-if="site.active" class="badge bg-success">Actif</span>
                                    <span t-else="" class="badge bg-secondary">Archivé</span>
                                </td>
                                <td><a t-att-href="'/my/agriculture/sites/%s' % site.id"
                                       class="btn btn-sm btn-outline-primary">Consulter</a></td>
                            </tr>
                            <tr t-if="not sites"><td colspan="8" class="text-center">Aucun site trouvé.</td></tr>
                        </tbody>
                    </table>
                </div>
                <a href="/my/agriculture" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>

    <template id="site_form" name="Formulaire site agricole">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <h2 t-if="site">Modifier le site</h2>
                <h2 t-else="">Nouveau site agricole</h2>
                <div t-if="error" class="alert alert-danger" role="alert"><t t-out="error"/></div>
                <form method="post"
                      t-att-action="('/my/agriculture/sites/%s/update' % site.id) if site else '/my/agriculture/sites/create'">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nom du site *</label>
                            <input name="name" required="required" class="form-control"
                                   t-att-value="values.get('name', site.name if site else '')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Exploitation *</label>
                            <select name="farm_id" required="required" class="form-select">
                                <option value="">Sélectionner</option>
                                <option t-foreach="farms" t-as="farm" t-att-value="farm.id"
                                        t-att-selected="str(values.get('farm_id', site.farm_id.id if site else '')) == str(farm.id)">
                                    <t t-out="farm.name"/>
                                </option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Type de site</label>
                            <select name="site_type" class="form-select">
                                <option value="production" t-att-selected="values.get('site_type', site.site_type if site else 'production') == 'production'">Production</option>
                                <option value="storage" t-att-selected="values.get('site_type', site.site_type if site else 'production') == 'storage'">Stockage</option>
                                <option value="livestock" t-att-selected="values.get('site_type', site.site_type if site else 'production') == 'livestock'">Élevage</option>
                                <option value="greenhouse" t-att-selected="values.get('site_type', site.site_type if site else 'production') == 'greenhouse'">Serres</option>
                                <option value="administration" t-att-selected="values.get('site_type', site.site_type if site else 'production') == 'administration'">Administration</option>
                                <option value="mixed" t-att-selected="values.get('site_type', site.site_type if site else 'production') == 'mixed'">Mixte</option>
                                <option value="other" t-att-selected="values.get('site_type', site.site_type if site else 'production') == 'other'">Autre</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Commune</label>
                            <input name="city" class="form-control"
                                   t-att-value="values.get('city', site.city if site else '')"/>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Adresse</label>
                            <input name="address" class="form-control"
                                   t-att-value="values.get('address', site.address if site else '')"/>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Observations</label>
                            <textarea name="notes" rows="3" class="form-control"><t t-out="values.get('notes', site.notes if site else '')"/></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" name="has_coordinates" value="1" class="form-check-input"
                                       t-att-checked="'checked' if values.get('has_coordinates', site.has_coordinates if site else False) else None"/>
                                <label class="form-check-label">Coordonnées GPS renseignées</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Latitude</label>
                            <input type="number" step="any" min="-90" max="90" name="latitude" class="form-control"
                                   t-att-value="values.get('latitude', site.latitude if site else '')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Longitude</label>
                            <input type="number" step="any" min="-180" max="180" name="longitude" class="form-control"
                                   t-att-value="values.get('longitude', site.longitude if site else '')"/>
                        </div>
                        <div class="col-12" t-if="site">
                            <div class="form-check">
                                <input type="checkbox" name="active" value="1" class="form-check-input"
                                       t-att-checked="'checked' if values.get('active', site.active) else None"/>
                                <label class="form-check-label">Site actif</label>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                        <a href="/my/agriculture/sites" class="btn btn-secondary">Annuler</a>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="site_detail" name="Détail site agricole">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 t-out="site.name"/>
                    <div>
                        <a t-att-href="'/my/agriculture/sites/%s/edit' % site.id" class="btn btn-primary">Modifier</a>
                        <a href="/my/agriculture/sites" class="btn btn-secondary">Retour</a>
                    </div>
                </div>
                <div class="card shadow-sm mb-3"><div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6"><strong>Référence :</strong> <t t-out="site.code or '-'"/></div>
                        <div class="col-md-6"><strong>Exploitation :</strong> <t t-out="site.farm_id.name"/></div>
                        <div class="col-md-6"><strong>Type :</strong> <t t-out="site_type_labels.get(site.site_type, site.site_type)"/></div>
                        <div class="col-md-6"><strong>Commune :</strong> <t t-out="site.city or '-'"/></div>
                        <div class="col-12"><strong>Adresse :</strong> <t t-out="site.address or '-'"/></div>
                        <div class="col-12"><strong>Parcelles :</strong> <t t-out="site.plot_count"/></div>
                        <div class="col-12"><strong>Infrastructures :</strong> <t t-out="site.infrastructure_count"/>
                            <a t-att-href="'/my/agriculture/infrastructures?search=' + site.name" class="ms-2">Consulter les infrastructures</a>
                        </div>
                        <div class="col-12" t-if="site.has_coordinates">
                            <strong>GPS :</strong> <t t-out="site.latitude"/> , <t t-out="site.longitude"/>
                            <a t-att-href="site.osm_url" target="_blank" rel="noopener">Voir sur OpenStreetMap</a>
                        </div>
                        <div class="col-12"><strong>Observations :</strong><div t-field="site.notes"/></div>
                    </div>
                </div></div>
                <form t-att-action="'/my/agriculture/sites/%s/delete' % site.id" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button type="submit" class="btn btn-outline-danger"
                            onclick="return confirm('Confirmer la suppression de ce site ?')">Supprimer</button>
                </form>
            </div>
        </t>
    </template>
</odoo>
