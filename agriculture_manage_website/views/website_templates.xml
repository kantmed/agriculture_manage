<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_home"
              name="Agriculture Website Home">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <h1 class="text-center">
                        Agriculture Management
                    </h1>
                    <p class="text-center lead">
                        Plateforme de gestion agricole.
                    </p>
                    <div class="row text-center mt-4">
                        <div class="col">
                            <h3 t-out="dashboard.site_count"/>
                            <p>Sites actifs</p>
                        </div>
                        <div class="col">
                            <h3 t-out="dashboard.plot_count"/>
                            <p>Parcelles actives</p>
                        </div>
                        <div class="col">
                            <h3 t-out="dashboard.total_area"/>
                            <p>Superficie totale (ha)</p>
                        </div>
                        <div class="col">
                            <h3 t-out="dashboard.cultivated_area"/>
                            <p>Superficie en culture (ha)</p>
                        </div>
                        <div class="col">
                            <h3 t-out="dashboard.available_area"/>
                            <p>Superficie disponible (ha)</p>
                        </div>
                        <div class="col">
                            <h3 t-out="dashboard.infrastructure_count"/>
                            <p>Infrastructures actives</p>
                        </div>
                    </div>
                    <div class="text-center mt-4">
                        <a href="/my/agriculture"
                           class="btn btn-primary btn-lg">
                            Accéder à mon espace
                        </a>
                    </div>
                    <div class="row mt-5">
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5>Exploitations</h5>
                                    <a href="/my/agriculture/farms" class="btn btn-primary btn-sm">Gérer</a>
                                    <a href="/my/agriculture/farms/new" class="btn btn-outline-primary btn-sm">Nouveau</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5>Parcelles</h5>
                                    <a href="/my/agriculture/plots" class="btn btn-primary btn-sm">Gérer</a>
                                    <a href="/my/agriculture/plots/new" class="btn btn-outline-primary btn-sm">Nouveau</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5>Campagnes</h5>
                                    <a href="/my/agriculture/campaigns" class="btn btn-primary btn-sm">Gérer</a>
                                    <a href="/my/agriculture/campaigns/new" class="btn btn-outline-primary btn-sm">Nouveau</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5>Sites</h5>
                                    <a href="/my/agriculture/sites" class="btn btn-primary btn-sm">Gérer</a>
                                    <a href="/my/agriculture/sites/new" class="btn btn-outline-primary btn-sm">Nouveau</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5>Infrastructures</h5>
                                    <a href="/my/agriculture/infrastructures" class="btn btn-primary btn-sm">Gérer</a>
                                    <a href="/my/agriculture/infrastructures/new" class="btn btn-outline-primary btn-sm">Nouveau</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5>Activités</h5>
                                    <a href="/my/agriculture/activities" class="btn btn-primary btn-sm">Gérer</a>
                                    <a href="/my/agriculture/activities/new" class="btn btn-outline-primary btn-sm">Nouveau</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
