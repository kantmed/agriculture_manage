<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="crop_list" name="Cultures">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="d-flex justify-content-between mb-3">
                    <h2>Cultures agricoles</h2>
                    <a href="/my/agriculture/crops/new" class="btn btn-primary">Nouvelle culture</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Type</th>
                                <th>Abréviation</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="crops" t-as="crop" t-key="crop.id">
                                <td><a t-att-href="'/my/agriculture/crops/%s' % crop.id" t-out="crop.name"/></td>
                                <td t-out="crop.crop_type_id.name"/>
                                <td t-out="crop.abbreviation"/>
                                <td>
                                    <a t-att-href="'/my/agriculture/crops/%s' % crop.id" class="btn btn-sm btn-outline-primary">Consulter</a>
                                </td>
                            </tr>
                            <tr t-if="not crops">
                                <td colspan="4" class="text-center">Aucune culture trouvée.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <a href="/my/agriculture" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>

    <template id="crop_form" name="Formulaire culture">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2 t-if="not crop">Nouvelle culture</h2>
                <h2 t-if="crop">Modifier la culture</h2>
                <form method="post" t-att-action="'/my/agriculture/crops/%s/update' % crop.id if crop else '/my/agriculture/crops/create'">
                    <div class="card"><div class="card-body">
                        <div class="mb-3">
                            <label>Nom</label>
                            <input type="text" name="name" class="form-control" required="required" t-att-value="values.get('name') if values else (crop.name if crop else '')"/>
                        </div>
                        <div class="mb-3">
                            <label>Type de culture</label>
                            <select name="crop_type_id" class="form-select">
                                <t t-foreach="crop_types" t-as="ct" t-key="ct.id">
                                    <option t-att-value="ct.id" t-att-selected="'selected' if (values.get('crop_type_id') if values else (crop.crop_type_id.id if crop else None)) == ct.id else None" t-out="ct.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label>Abréviation</label>
                            <input type="text" name="abbreviation" class="form-control" required="required" t-att-value="values.get('abbreviation') if values else (crop.abbreviation if crop else '')"/>
                        </div>
                        <div class="mb-3">
                            <label>Description</label>
                            <textarea name="description" class="form-control" t-out="values.get('description') if values else (crop.description if crop else '')"/>
                        </div>
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                        <a href="/my/agriculture/crops" class="btn btn-secondary">Annuler</a>
                    </div></div>
                </form>
            </div>
        </t>
    </template>

    <template id="crop_detail" name="Détail culture">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2 t-out="crop.name"/>
                <p>Type : <span t-out="crop.crop_type_id.name"/></p>
                <p>Abréviation : <span t-out="crop.abbreviation"/></p>
                <p t-out="crop.description"/>
                <a t-att-href="'/my/agriculture/crops/%s/edit' % crop.id" class="btn btn-secondary">Modifier</a>
                <form t-att-action="'/my/agriculture/crops/%s/delete' % crop.id" method="post" style="display:inline">
                    <button type="submit" class="btn btn-danger">Supprimer</button>
                </form>
                <a href="/my/agriculture/crops" class="btn btn-secondary">Retour</a>
            </div>
        </t>
    </template>
</odoo>