<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_livestock_sale_orders" model="ir.actions.act_window">
        <field name="name">Ventes d'élevage</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('livestock_sale', '=', True)]</field>
        <field name="context">{'default_livestock_sale': True}</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
    </record>

    <record id="view_order_form_livestock" model="ir.ui.view">
        <field name="name">sale.order.form.livestock</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Élevage" name="livestock_sale">
                    <group>
                        <group>
                            <field name="livestock_sale"/>
                            <field name="livestock_animal_id" invisible="not livestock_sale"/>
                            <field name="livestock_herd_id" invisible="not livestock_sale"/>
                            <field name="livestock_quantity" invisible="not livestock_sale or not livestock_herd_id"/>
                        </group>
                        <group invisible="not livestock_sale">
                            <field name="livestock_farm_id" readonly="1"/>
                            <field name="livestock_species_id" readonly="1"/>
                            <field name="livestock_movement_id" readonly="1"/>
                            <button name="action_view_livestock_movement" type="object"
                                    string="Voir le mouvement de cheptel"
                                    class="oe_link"
                                    invisible="not livestock_movement_id"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Le cheptel ne sera marqué comme vendu qu'après la livraison complète
                        des produits de la commande dans l'application Inventaire.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
