<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhealth_list" model="ir.ui.view">
        <field name="name">agriculture.livestock.health.list</field>
        <field name="model">agriculture.livestock.health</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="event_type"/>
                <field name="animal_id"/>
                <field name="herd_id"/>
                <field name="farm_id"/>
                <field name="product_id"/>
                <field name="next_date"/>
                <field name="cost"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_lhealth_form" model="ir.ui.view">
        <field name="name">agriculture.livestock.health.form</field>
        <field name="model">agriculture.livestock.health</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" type="object" string="Marquer comme réalisé" class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_cancel" type="object" string="Annuler" invisible="state != 'planned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="animal_id" domain="[('state', '=', 'active')]" options="{'no_create': True}"/>
                            <field name="herd_id" domain="[('active', '=', True)]" options="{'no_create': True}"/>
                            <field name="farm_id" readonly="1"/>
                            <field name="species_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="done_date" invisible="state != 'done'"/>
                            <field name="next_date"/>
                            <field name="veterinarian"/>
                            <field name="cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Diagnostic et soins">
                            <group>
                                <field name="diagnosis"/>
                                <field name="symptoms"/>
                                <field name="treatment"/>
                                <field name="notes"/>
                            </group>
                        </page>
                        <page string="Médicament / vaccin">
                            <group>
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="product_uom_id"/>
                                <field name="dosage"/>
                            </group>
                        </page>
                        <page string="Délais d'attente">
                            <group>
                                <field name="meat_withdrawal_days"/>
                                <field name="meat_withdrawal_end"/>
                                <field name="milk_withdrawal_days"/>
                                <field name="milk_withdrawal_end"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_lhealth" model="ir.actions.act_window">
        <field name="name">Suivi sanitaire</field>
        <field name="res_model">agriculture.livestock.health</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_planned': 1}</field>
    </record>
    <record id="view_lhealth_search" model="ir.ui.view">
        <field name="name">agriculture.livestock.health.search</field>
        <field name="model">agriculture.livestock.health</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="animal_id"/>
                <field name="herd_id"/>
                <field name="event_type"/>
                <filter name="planned" string="Planifiés" domain="[('state', '=', 'planned')]"/>
                <filter name="done" string="Réalisés" domain="[('state', '=', 'done')]"/>
                <filter name="cancel" string="Annulés" domain="[('state', '=', 'cancel')]"/>
            </search>
        </field>
    </record>

    <record id="view_lanimal_form_health" model="ir.ui.view">
        <field name="name">agriculture.livestock.animal.form.health</field>
        <field name="model">agriculture.livestock.animal</field>
        <field name="inherit_id" ref="view_lanimal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Santé">
                    <field name="health_event_ids" context="{'default_animal_id': id}">
                        <list>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="event_type"/>
                            <field name="product_id"/>
                            <field name="next_date"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_lherd_form_health" model="ir.ui.view">
        <field name="name">agriculture.livestock.herd.form.health</field>
        <field name="model">agriculture.livestock.herd</field>
        <field name="inherit_id" ref="view_lherd_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Santé du lot" invisible="tracking_mode != 'batch'">
                    <field name="health_event_ids" context="{'default_herd_id': id}">
                        <list>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="event_type"/>
                            <field name="product_id"/>
                            <field name="next_date"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
