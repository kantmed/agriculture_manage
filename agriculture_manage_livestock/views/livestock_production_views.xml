<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lproduction_list" model="ir.ui.view">
        <field name="name">agriculture.livestock.production.list</field>
        <field name="model">agriculture.livestock.production</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="farm_id"/>
                <field name="species_id"/>
                <field name="production_type"/>
                <field name="animal_id"/>
                <field name="herd_id"/>
                <field name="headcount"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="quantity_per_head"/>
                <field name="quality"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_lproduction_form" model="ir.ui.view">
        <field name="name">agriculture.livestock.production.form</field>
        <field name="model">agriculture.livestock.production</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" type="object"
                            string="Enregistrer la production" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object"
                            string="Annuler" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="draft,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="production_type"/>
                            <field name="product_description"
                                   invisible="production_type != 'other'"/>
                            <field name="farm_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="species_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="animal_id"
                                   domain="[('state', '=', 'active')]"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="herd_id"
                                   domain="[('active', '=', True)]"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="headcount" readonly="1"/>
                            <field name="recorded_by" readonly="1"/>
                        </group>
                    </group>
                    <group string="Quantité produite">
                        <group>
                            <field name="quantity" readonly="state != 'draft'"/>
                            <field name="uom_id" readonly="state != 'draft'"/>
                            <field name="quantity_per_head" readonly="1"/>
                        </group>
                        <group>
                            <field name="quality" readonly="state != 'draft'"/>
                            <field name="collection_reference" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observations">
                            <field name="notes" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_lproduction_search" model="ir.ui.view">
        <field name="name">agriculture.livestock.production.search</field>
        <field name="model">agriculture.livestock.production</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="farm_id"/>
                <field name="species_id"/>
                <field name="production_type"/>
                <field name="animal_id"/>
                <field name="herd_id"/>
                <filter name="draft" string="Brouillons"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="done" string="Enregistrées"
                        domain="[('state', '=', 'done')]"/>
                <filter name="cancel" string="Annulées"
                        domain="[('state', '=', 'cancel')]"/>
            </search>
        </field>
    </record>

    <record id="action_lproduction" model="ir.actions.act_window">
        <field name="name">Productions animales</field>
        <field name="res_model">agriculture.livestock.production</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lproduction_search"/>
    </record>
</odoo>
