<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lration_list" model="ir.ui.view">
        <field name="name">agriculture.livestock.ration.list</field>
        <field name="model">agriculture.livestock.ration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="farm_id"/>
                <field name="species_id"/>
                <field name="purpose"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_lration_form" model="ir.ui.view">
        <field name="name">agriculture.livestock.ration.form</field>
        <field name="model">agriculture.livestock.ration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="farm_id"/>
                            <field name="species_id"/>
                            <field name="purpose"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Composition">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"
                                           domain="[('product_tmpl_id.agriculture_category', '=', 'feed')]"/>
                                    <field name="quantity_per_head"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observations"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_lration" model="ir.actions.act_window">
        <field name="name">Rations alimentaires</field>
        <field name="res_model">agriculture.livestock.ration</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_lfeeding_list" model="ir.ui.view">
        <field name="name">agriculture.livestock.feeding.list</field>
        <field name="model">agriculture.livestock.feeding</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="farm_id"/>
                <field name="species_id"/>
                <field name="animal_id"/>
                <field name="herd_id"/>
                <field name="headcount"/>
                <field name="ration_id"/>
                <field name="warehouse_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_lfeeding_form" model="ir.ui.view">
        <field name="name">agriculture.livestock.feeding.form</field>
        <field name="model">agriculture.livestock.feeding</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply_ration" type="object"
                            string="Appliquer la ration" class="btn-secondary"
                            invisible="state != 'draft' or not ration_id"/>
                    <button name="action_prepare_stock_issue" type="object"
                            string="Préparer la sortie de stock" class="btn-primary"
                            invisible="state not in ('draft', 'prepared')"
                            groups="stock.group_stock_user"/>
                    <button name="action_mark_done" type="object"
                            string="Clôturer la distribution" class="btn-primary"
                            invisible="state != 'prepared'"
                            groups="stock.group_stock_user"/>
                    <button name="action_cancel" type="object"
                            string="Annuler" invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,prepared,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" groups="stock.group_stock_user">
                        <button name="action_open_stock_pickings" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="stock_picking_count == 0">
                            <field name="stock_picking_count" widget="statinfo"
                                   string="Sorties de stock"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="farm_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="species_id" readonly="1"/>
                            <field name="animal_id" domain="[('state', '=', 'active')]"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="herd_id" domain="[('active', '=', True)]"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="headcount" readonly="1"/>
                            <field name="feeding_days" readonly="state != 'draft'"/>
                            <field name="ration_id" readonly="state != 'draft'"
                                   domain="[('farm_id', '=', farm_id), ('species_id', '=', species_id), ('active', '=', True)]"/>
                            <field name="warehouse_id" readonly="state != 'draft'"
                                   domain="['|', ('farm_id', '=', False), ('farm_id', '=', farm_id)]"
                                   groups="stock.group_stock_user"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Aliments distribués">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"
                                           domain="[('product_tmpl_id.agriculture_category', '=', 'feed')]"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sorties de stock">
                            <field name="stock_picking_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="scheduled_date"/>
                                    <field name="picking_type_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observations"><field name="notes" readonly="state != 'draft'"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_lfeeding_search" model="ir.ui.view">
        <field name="name">agriculture.livestock.feeding.search</field>
        <field name="model">agriculture.livestock.feeding</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="farm_id"/>
                <field name="species_id"/>
                <field name="animal_id"/>
                <field name="herd_id"/>
                <filter name="draft" string="Brouillons" domain="[('state', '=', 'draft')]"/>
                <filter name="prepared" string="Sorties préparées" domain="[('state', '=', 'prepared')]"/>
                <filter name="done" string="Terminées" domain="[('state', '=', 'done')]"/>
            </search>
        </field>
    </record>
    <record id="action_lfeeding" model="ir.actions.act_window">
        <field name="name">Distributions alimentaires</field>
        <field name="res_model">agriculture.livestock.feeding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
    </record>
</odoo>
