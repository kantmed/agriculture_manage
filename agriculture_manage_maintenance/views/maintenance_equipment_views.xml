<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_equipment_agriculture_list" model="ir.ui.view">
        <field name="name">maintenance.equipment.agriculture.list</field>
        <field name="model">maintenance.equipment</field>
        <field name="arch" type="xml">
            <list string="Équipements agricoles">
                <field name="name"/>
                <field name="serial_no" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="agriculture_farm_id"/>
                <field name="agriculture_site_id" optional="show"/>
                <field name="agriculture_infrastructure_id" optional="show"/>
                <field name="technician_user_id" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_equipment_agriculture_form" model="ir.ui.view">
        <field name="name">maintenance.equipment.agriculture.form</field>
        <field name="model">maintenance.equipment</field>
        <field name="arch" type="xml">
            <form string="Équipement agricole">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Nom de l'équipement"/></h1></div>
                    <group>
                        <group string="Identification">
                            <field name="category_id"/>
                            <field name="serial_no"/>
                            <field name="owner_user_id"/>
                            <field name="technician_user_id"/>
                            <field name="maintenance_team_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Localisation agricole">
                            <field name="agriculture_farm_id" options="{'no_create': True}"/>
                            <field name="agriculture_site_id" options="{'no_create': True}"/>
                            <field name="agriculture_infrastructure_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Suivi de maintenance">
                        <group>
                            <field name="effective_date"/>
                            <field name="warranty_date"/>
                        </group>
                        <group>
                            <field name="expected_mtbf"/>
                            <field name="mtbf" readonly="1"/>
                            <field name="mttr" readonly="1"/>
                            <field name="estimated_next_failure" readonly="1"/>
                            <field name="maintenance_count" readonly="1"/>
                            <field name="maintenance_open_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Historique des interventions">
                            <field name="maintenance_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="maintenance_type"/>
                                    <field name="schedule_date"/>
                                    <field name="state"/>
                                    <field name="duration"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="note" placeholder="Observations et caractéristiques techniques..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_maintenance_equipment_agriculture_search" model="ir.ui.view">
        <field name="name">maintenance.equipment.agriculture.search</field>
        <field name="model">maintenance.equipment</field>
        <field name="arch" type="xml">
            <!-- Recherche volontairement minimale pour rester compatible avec Odoo 20.
                 Les filtres avancés seront réintroduits après validation sur l'instance cible. -->
            <search string="Équipements agricoles">
                <field name="name"/>
                <field name="serial_no"/>
            </search>
        </field>
    </record>

    <record id="action_agriculture_maintenance_equipment" model="ir.actions.act_window">
        <field name="name">Équipements agricoles</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_maintenance_equipment_agriculture_search"/>
        <field name="domain">[('agriculture_farm_id', '!=', False)]</field>
    </record>
    <record id="action_agriculture_maintenance_equipment_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_maintenance_equipment_agriculture_list"/>
        <field name="act_window_id" ref="action_agriculture_maintenance_equipment"/>
    </record>
    <record id="action_agriculture_maintenance_equipment_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_maintenance_equipment_agriculture_form"/>
        <field name="act_window_id" ref="action_agriculture_maintenance_equipment"/>
    </record>
</odoo>
