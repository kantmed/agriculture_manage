<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_request_agriculture_list" model="ir.ui.view">
        <field name="name">maintenance.request.agriculture.list</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <list string="Interventions agricoles">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="agriculture_farm_id"/>
                <field name="agriculture_site_id" optional="show"/>
                <field name="agriculture_infrastructure_id" optional="show"/>
                <field name="maintenance_type"/>
                <field name="schedule_date" optional="show"/>
                <field name="user_ids" widget="many2many_tags" optional="show"/>
                <field name="stage_id" readonly="1"/>
                <field name="agriculture_intervention_cost" optional="hide" sum="Coût total"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_request_agriculture_form" model="ir.ui.view">
        <field name="name">maintenance.request.agriculture.form</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <form string="Intervention de maintenance agricole">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Objet de l'intervention"/></h1></div>
                    <group>
                        <group string="Demande">
                            <field name="equipment_id" domain="[('agriculture_farm_id', '!=', False)]" options="{'no_create': True}"/>
                            <field name="maintenance_type"/>
                            <field name="schedule_date"/>
                            <field name="maintenance_team_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="priority" widget="priority"/>
                            <field name="stage_id" readonly="1"/>
                            <field name="state"/>
                            <field name="recurring_maintenance"/>
                            <field name="repeat_interval" invisible="not recurring_maintenance"/>
                            <field name="repeat_unit" invisible="not recurring_maintenance"/>
                            <field name="repeat_type" invisible="not recurring_maintenance"/>
                            <field name="repeat_until" invisible="not recurring_maintenance or repeat_type != 'until'"/>
                        </group>
                        <group string="Localisation agricole">
                            <field name="agriculture_farm_id" readonly="1"/>
                            <field name="agriculture_site_id" readonly="1"/>
                            <field name="agriculture_infrastructure_id" readonly="1"/>
                            <field name="duration"/>
                            <field name="agriculture_intervention_cost"/>
                            <field name="agriculture_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Diagnostic, travaux effectués, pièces utilisées et recommandations..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_maintenance_request_agriculture_search" model="ir.ui.view">
        <field name="name">maintenance.request.agriculture.search</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <!-- Vue volontairement minimale : uniquement les champs standards
                 du modèle maintenance.request d'Odoo 20. -->
            <search string="Interventions agricoles">
                <field name="name"/>
                <field name="equipment_id"/>
                <filter name="corrective" string="Corrective" domain="[('maintenance_type', '=', 'corrective')]"/>
                <filter name="preventive" string="Préventive" domain="[('maintenance_type', '=', 'preventive')]"/>
            </search>
        </field>
    </record>

    <record id="action_agriculture_maintenance_request" model="ir.actions.act_window">
        <field name="name">Interventions agricoles</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_maintenance_request_agriculture_search"/>
        <field name="domain">[('agriculture_farm_id', '!=', False)]</field>
    </record>
    <record id="action_agriculture_maintenance_request_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_maintenance_request_agriculture_list"/>
        <field name="act_window_id" ref="action_agriculture_maintenance_request"/>
    </record>
    <record id="action_agriculture_maintenance_request_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_maintenance_request_agriculture_form"/>
        <field name="act_window_id" ref="action_agriculture_maintenance_request"/>
    </record>
</odoo>
