<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_infrastructure_form_maintenance" model="ir.ui.view">
        <field name="name">agriculture.farm.infrastructure.form.maintenance</field>
        <field name="model">agriculture.farm.infrastructure</field>
        <field name="inherit_id" ref="agriculture_manage.view_farm_infrastructure_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@class='oe_title']" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_maintenance_equipment" type="object" class="oe_stat_button" icon="fa-cogs">
                        <field name="maintenance_equipment_count" widget="statinfo" string="Équipements"/>
                    </button>
                    <button name="action_view_maintenance_requests" type="object" class="oe_stat_button" icon="fa-wrench">
                        <field name="maintenance_request_count" widget="statinfo" string="Interventions"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_agriculture_maintenance_root" name="Maintenance" parent="agriculture_manage.menu_farm_root" sequence="60" groups="agriculture_manage.group_farm_user"/>
    <menuitem id="menu_agriculture_maintenance_equipment" name="Équipements" parent="menu_agriculture_maintenance_root" action="action_agriculture_maintenance_equipment" sequence="10" groups="agriculture_manage.group_farm_user"/>
    <menuitem id="menu_agriculture_maintenance_requests" name="Interventions" parent="menu_agriculture_maintenance_root" action="action_agriculture_maintenance_request" sequence="20" groups="agriculture_manage.group_farm_user"/>
</odoo>
