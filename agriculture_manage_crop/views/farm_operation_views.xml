<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_operation_list" model="ir.ui.view">
        <field name="name">agriculture.farm.operation.list</field>
        <field name="model">agriculture.farm.operation</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="plot_id"/>
                <field name="operation_type"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_farm_operation_form" model="ir.ui.view">
        <field name="name">agriculture.farm.operation.form</field>
        <field name="model">agriculture.farm.operation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" type="object" string="Valider" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Annuler" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de l'opération"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="campaign_id"/>
                            <field name="plot_id"/>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                        </group>
                        <group>
                            <field name="operation_type"/>
                            <field name="date"/>
                            <field name="picking_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                    <notebook>
                        <page string="Intrants">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="provider_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="cost"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observations">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_farm_operation" model="ir.actions.act_window">
        <field name="name">Opérations</field>
        <field name="res_model">agriculture.farm.operation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
