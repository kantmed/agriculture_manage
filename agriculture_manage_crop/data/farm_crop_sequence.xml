<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_farm_crop" model="ir.sequence">
            <field name="name">Référence culture</field>
            <field name="code">farm.crop</field>
            <field name="prefix">CUL/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_farm_crop_campaign" model="ir.sequence">
            <field name="name">Référence campagne</field>
            <field name="code">farm.crop.campaign</field>
            <field name="prefix">CAM/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_farm_harvest" model="ir.sequence">
            <field name="name">Référence récolte</field>
            <field name="code">farm.harvest</field>
            <field name="prefix">REC/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_farm_harvest_lot" model="ir.sequence">
            <field name="name">Référence lot</field>
            <field name="code">farm.harvest.lot</field>
            <field name="prefix">LOT/</field>
            <field name="padding">5</field>
        </record>
    </data>
    <data>
        <record id="seq_farm_operation" model="ir.sequence">
            <field name="name">Référence opération</field>
            <field name="code">farm.operation</field>
            <field name="prefix">OPE-%(year)s%(month)s%(day)s-</field>
            <field name="padding">2</field>
        </record>
    </data>
</odoo>
