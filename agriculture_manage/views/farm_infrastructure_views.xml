<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_infrastructure_list" model="ir.ui.view">
        <field name="name">agriculture.farm.infrastructure.list</field>
        <field name="model">agriculture.farm.infrastructure</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="farm_id"/>
                <field name="site_id"/>
                <field name="infrastructure_type"/>
                <field name="condition"/>
                <field name="construction_date"/>
            </list>
        </field>
    </record>

    <record id="view_farm_infrastructure_form" model="ir.ui.view">
        <field name="name">agriculture.farm.infrastructure.form</field>
        <field name="model">agriculture.farm.infrastructure</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de l'infrastructure"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="farm_id"/>
                            <field name="site_id"/>
                            <field name="infrastructure_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="construction_date"/>
                            <field name="condition"/>
                            <field name="area"/>
                            <field name="capacity"/>
                            <field name="capacity_unit"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description de l'infrastructure..."/>
                </sheet>
            <chatter/>
            </form>
        </field>
    </record>

    <record id="view_farm_infrastructure_search" model="ir.ui.view">
        <field name="name">agriculture.farm.infrastructure.search</field>
        <field name="model">agriculture.farm.infrastructure</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="farm_id"/>
                <field name="site_id"/>
                <filter name="active" string="Actives" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archivées" domain="[('active', '=', False)]"/>
                    <filter name="group_farm" string="Exploitation" context="{'group_by': 'farm_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'infrastructure_type'}"/>
                    <filter name="group_condition" string="État" context="{'group_by': 'condition'}"/>
            </search>
        </field>
    </record>

    <record id="action_farm_infrastructure" model="ir.actions.act_window">
        <field name="name">Infrastructures</field>
        <field name="res_model">agriculture.farm.infrastructure</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première infrastructure
            </p>
        </field>
    </record>
</odoo>
