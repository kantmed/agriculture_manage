<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_activity_type_list" model="ir.ui.view">
        <field name="name">agriculture.farm.activity.type.list</field>
        <field name="model">agriculture.farm.activity.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_farm_activity_type_form" model="ir.ui.view">
        <field name="name">agriculture.farm.activity.type.form</field>
        <field name="model">agriculture.farm.activity.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description de l'activité..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_farm_activity_type" model="ir.actions.act_window">
        <field name="name">Types d'activité</field>
        <field name="res_model">agriculture.farm.activity.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
