<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_farm_dashboard_farm_area_graph" model="ir.ui.view">
            <field name="name">agriculture.farm.dashboard.area.graph</field>
            <field name="model">agriculture.farm</field>
            <field name="arch" type="xml">
                <graph string="Superficie par exploitation" type="bar">
                    <field name="name" type="row"/>
                    <field name="total_area" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="view_farm_dashboard_plot_state_graph" model="ir.ui.view">
            <field name="name">agriculture.farm.plot.dashboard.state.graph</field>
            <field name="model">agriculture.farm.plot</field>
            <field name="arch" type="xml">
                <graph string="Superficie par état de parcelle" type="bar">
                    <field name="state" type="row"/>
                    <field name="area_ha" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="action_farm_dashboard_farm_area" model="ir.actions.act_window">
            <field name="name">Superficie par exploitation</field>
            <field name="res_model">agriculture.farm</field>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="view_farm_dashboard_farm_area_graph"/>
            <field name="domain">[('active', '=', True)]</field>
        </record>

        <record id="action_farm_dashboard_plot_state" model="ir.actions.act_window">
            <field name="name">Superficie par état de parcelle</field>
            <field name="res_model">agriculture.farm.plot</field>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="view_farm_dashboard_plot_state_graph"/>
            <field name="domain">[('active', '=', True)]</field>
        </record>

        <record id="view_farm_dashboard_board" model="ir.ui.view">
            <field name="name">agriculture.farm.dashboard.board</field>
            <field name="model">agriculture.farm.dashboard</field>
            <field name="arch" type="xml">
                <form string="Tableau de bord agricole" create="0" edit="0">
                    <sheet>
                        <div class="oe_title">
                            <h1>Tableau de bord agricole</h1>
                            <h2><field name="company_name" nolabel="1"/></h2>
                        </div>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_sites" type="object"
                                    class="oe_stat_button" icon="fa-map-marker">
                                <div class="o_stat_info">
                                    <field name="site_count" class="o_stat_value"/>
                                    <span class="o_stat_text">Sites actifs</span>
                                </div>
                            </button>
                            <button name="action_open_plots" type="object"
                                    class="oe_stat_button" icon="fa-leaf">
                                <div class="o_stat_info">
                                    <field name="plot_count" class="o_stat_value"/>
                                    <span class="o_stat_text">Parcelles actives</span>
                                </div>
                            </button>
                            <button name="action_open_farms" type="object"
                                    class="oe_stat_button" icon="fa-tractor">
                                <div class="o_stat_info">
                                    <field name="farm_count" class="o_stat_value"/>
                                    <span class="o_stat_text">Exploitations actives</span>
                                </div>
                            </button>
                            <button name="action_open_cultivated_plots" type="object"
                                    class="oe_stat_button" icon="fa-seedling">
                                <div class="o_stat_info">
                                    <field name="cultivated_area" class="o_stat_value"/>
                                    <span class="o_stat_text">Superficie en culture (ha)</span>
                                </div>
                            </button>
                            <button name="action_open_available_plots" type="object"
                                    class="oe_stat_button" icon="fa-th-large">
                                <div class="o_stat_info">
                                    <field name="available_area" class="o_stat_value"/>
                                    <span class="o_stat_text">Superficie disponible (ha)</span>
                                </div>
                            </button>
                            <button name="action_open_infrastructures" type="object"
                                    class="oe_stat_button" icon="fa-building">
                                <div class="o_stat_info">
                                    <field name="infrastructure_count" class="o_stat_value"/>
                                    <span class="o_stat_text">Infrastructures actives</span>
                                </div>
                            </button>
                        </div>
                        <group string="Répartition des superficies">
                            <group>
                                <field name="total_area" readonly="1"/>
                                <field name="allocated_area" readonly="1"/>
                                <field name="unallocated_area" readonly="1"/>
                            </group>
                        </group>
                        <separator string="Analyses"/>
                        <div class="d-flex gap-2">
                            <button name="%(action_farm_dashboard_farm_area)d"
                                    type="action" string="Superficie par exploitation"
                                    class="btn btn-secondary"/>
                            <button name="%(action_farm_dashboard_plot_state)d"
                                    type="action" string="Superficie par état de parcelle"
                                    class="btn btn-secondary"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_farm_dashboard" model="ir.actions.act_window">
            <field name="name">Tableau de bord</field>
            <field name="res_model">agriculture.farm.dashboard</field>
            <field name="view_mode">form</field>
            <field name="usage">menu</field>
            <field name="view_id" ref="view_farm_dashboard_board"/>
        </record>

        <record id="action_open_farm_dashboard" model="ir.actions.server">
            <field name="name">Afficher le tableau de bord agricole</field>
            <field name="model_id" ref="model_agriculture_farm_dashboard"/>
            <field name="group_ids" eval="[(4, ref('group_farm_user'))]"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_dashboard()</field>
        </record>
    </data>
</odoo>