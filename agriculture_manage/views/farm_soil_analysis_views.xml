<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_soil_analysis_list" model="ir.ui.view">
        <field name="name">agriculture.farm.soil.analysis.list</field>
        <field name="model">agriculture.farm.soil.analysis</field>
        <field name="arch" type="xml">
            <list>
                <field name="analysis_date"/>
                <field name="plot_id"/>
                <field name="ph"/>
                <field name="fertility"/>
                <field name="organic_matter"/>
                <field name="slope"/>
                <field name="water_availability"/>
            </list>
        </field>
    </record>
    <record id="view_farm_soil_analysis_form" model="ir.ui.view">
        <field name="name">agriculture.farm.soil.analysis.form</field>
        <field name="model">agriculture.farm.soil.analysis</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="plot_id"/>
                        <field name="analysis_date"/>
                        <field name="ph"/>
                        <field name="fertility"/>
                        <field name="organic_matter"/>
                        <field name="slope"/>
                        <field name="water_source"/>
                        <field name="water_availability"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>