<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_list" model="ir.ui.view">
        <field name="name">agriculture.farm.list</field>
        <field name="model">agriculture.farm</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="manager_id"/>
                <field name="city"/>
                <field name="total_area"/>
                <field name="allocated_area"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_farm_form" model="ir.ui.view">
        <field name="name">agriculture.farm.form</field>
        <field name="model">agriculture.farm</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de l'exploitation"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="manager_id"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="total_area"/>
                            <field name="allocated_area" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Adresse">
                        <group>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Activités">
                            <field name="activity_type_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Sites">
                            <field name="site_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="site_type"/>
                                    <field name="city"/>
                                </list>
                            </field>
                        </page>
                        <page string="Parcelles">
                            <field name="plot_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="area_ha"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observations">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            <chatter/>
            </form>
        </field>
    </record>

    <record id="view_farm_search" model="ir.ui.view">
        <field name="name">agriculture.farm.search</field>
        <field name="model">agriculture.farm</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="city"/>
                <filter name="active" string="Actives" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archivées" domain="[('active', '=', False)]"/>
                    <filter name="group_manager" string="Responsable" context="{'group_by': 'manager_id'}"/>
                    <filter name="group_company" string="Société" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_farm" model="ir.actions.act_window">
        <field name="name">Exploitations</field>
        <field name="res_model">agriculture.farm</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première exploitation agricole
            </p>
        </field>
    </record>
</odoo>
