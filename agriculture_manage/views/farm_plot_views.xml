<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_plot_list" model="ir.ui.view">
        <field name="name">agriculture.farm.plot.list</field>
        <field name="model">agriculture.farm.plot</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="farm_id"/>
                <field name="site_id"/>
                <field name="area_ha"/>
                <field name="soil_type"/>
                <field name="soil_ph" optional="hide"/>
                <field name="soil_fertility" optional="hide"/>
                <field name="irrigation_type_id"/>
                <field name="irrigation_water_source" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_farm_plot_form" model="ir.ui.view">
        <field name="name">agriculture.farm.plot.form</field>
        <field name="model">agriculture.farm.plot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la parcelle"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="farm_id"/>
                            <field name="site_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="area"/>
                            <field name="area_unit"/>
                            <field name="area_ha"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Caractéristiques du sol">
                        <group>
                            <field name="soil_type"/>
                            <field name="soil_ph"/>
                            <field name="soil_fertility"/>
                            <field name="organic_matter_percent"/>
                        </group>
                        <group>
                            <field name="slope_percent"/>
                            <field name="soil_analysis_date"/>
                        </group>
                        <field name="soil_notes" placeholder="Résultats d'analyse, recommandations et observations..."/>
                    </group>
                    <group string="Irrigation et ressource en eau">
                        <group>
                            <field name="irrigation_type_id"/>
                            <field name="irrigation_water_source"/>
                        </group>
                        <group>
                            <field name="water_availability"/>
                        </group>
                    </group>
                    <group>
                        <group string="Coordonnées GPS">
                            <field name="has_coordinates"/>
                            <field name="latitude" invisible="not has_coordinates"/>
                            <field name="longitude" invisible="not has_coordinates"/>
                            <field name="osm_url" widget="url" invisible="not has_coordinates"/>
                        </group>
                    </group>
                </sheet>
            <chatter/>
            </form>
        </field>
    </record>

    <record id="view_farm_plot_search" model="ir.ui.view">
        <field name="name">agriculture.farm.plot.search</field>
        <field name="model">agriculture.farm.plot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="farm_id"/>
                <field name="site_id"/>
                <filter name="active" string="Actives" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archivées" domain="[('active', '=', False)]"/>
                <filter name="available" string="Disponibles" domain="[('state', '=', 'available')]"/>
                <filter name="cultivated" string="En culture" domain="[('state', '=', 'cultivated')]"/>
                    <filter name="group_farm" string="Exploitation" context="{'group_by': 'farm_id'}"/>
                    <filter name="group_site" string="Site" context="{'group_by': 'site_id'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_farm_plot" model="ir.actions.act_window">
        <field name="name">Parcelles</field>
        <field name="res_model">agriculture.farm.plot</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première parcelle
            </p>
        </field>
    </record>
</odoo>
