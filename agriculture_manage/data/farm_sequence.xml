<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_agriculture_farm_yearly" model="ir.sequence">
            <field name="name">Référence exploitation</field>
            <field name="code">farm.farm.yearly</field>
            <field name="prefix">EXP-%(year)s-</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
        </record>

        <record id="seq_agriculture_farm_infrastructure" model="ir.sequence">
            <field name="name">Référence infrastructure</field>
            <field name="code">farm.infrastructure</field>
            <field name="prefix">INF/</field>
            <field name="padding">5</field>
        </record>

    </data>
</odoo>