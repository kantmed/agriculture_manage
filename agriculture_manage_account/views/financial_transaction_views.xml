<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agri_financial_transaction_list" model="ir.ui.view">
        <field name="name">agriculture.farm.financial.transaction.list</field><field name="model">agriculture.farm.financial.transaction</field>
        <field name="arch" type="xml"><list string="Mouvements financiers" decoration-muted="state == 'cancelled'" decoration-info="payment_state == 'partial'" decoration-danger="payment_state == 'not_paid' and state == 'posted'"><field name="reference"/><field name="date"/><field name="name"/><field name="transaction_type"/><field name="category"/><field name="farm_id"/><field name="campaign_id" optional="hide"/><field name="partner_id"/><field name="amount" sum="Total"/><field name="paid_amount" sum="Réglé"/><field name="residual_amount" sum="Reste"/><field name="payment_state"/><field name="state"/></list></field>
    </record>
    <record id="view_agri_financial_transaction_form" model="ir.ui.view">
        <field name="name">agriculture.farm.financial.transaction.form</field><field name="model">agriculture.farm.financial.transaction</field>
        <field name="arch" type="xml"><form string="Mouvement financier agricole"><header>
            <button name="action_post" type="object" string="Valider" class="oe_highlight" invisible="state != 'draft'"/>
            <button name="action_register_payment" type="object" string="Ouvrir la pièce / régler" invisible="state != 'posted' or transaction_type == 'transfer' or payment_state == 'paid'"/>
            <button name="action_set_draft" type="object" string="Remettre en brouillon" invisible="state == 'draft'"/>
            <button name="action_cancel" type="object" string="Annuler" invisible="state != 'posted'"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancelled"/>
        </header><sheet>
            <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Ex. Vente de blé / Achat d'engrais"/></h1></div>
            <group><group><field name="reference"/><field name="transaction_type"/><field name="category" invisible="transaction_type == 'transfer'"/><field name="date"/><field name="company_id" groups="base.group_multi_company"/></group>
            <group><field name="amount"/><field name="currency_id"/><field name="account_id" string="Compte financier / source"/><field name="destination_account_id" invisible="transaction_type != 'transfer'"/><field name="partner_id" invisible="transaction_type == 'transfer'"/><field name="product_id" invisible="transaction_type == 'transfer'" required="transaction_type != 'transfer'"/></group></group>
            <group string="Affectation agricole" invisible="transaction_type == 'transfer'"><group><field name="farm_id"/><field name="campaign_id" domain="[('farm_id', '=', farm_id)]"/><field name="plot_id" domain="[('farm_id', '=', farm_id)]"/></group><group><field name="operation_id" domain="[('campaign_id', '=', campaign_id)]"/><field name="harvest_id" domain="[('campaign_id', '=', campaign_id)]"/><field name="budget_id" domain="[('campaign_id', '=', campaign_id)]" invisible="transaction_type != 'expense'"/></group></group>
            <group string="Comptabilité native" invisible="transaction_type == 'transfer' or not account_move_id"><field name="account_move_id" readonly="1"/><button name="action_view_account_move" type="object" string="Ouvrir la facture / pièce comptable" class="oe_link"/></group><group string="Situation du règlement" invisible="transaction_type == 'transfer'"><group><field name="paid_amount"/><field name="residual_amount"/></group><group><field name="payment_state"/></group></group>
            <notebook><page string="Anciens règlements" invisible="transaction_type == 'transfer' or account_move_id"><field name="account_move_id" invisible="1"/><field name="payment_ids" readonly="state != 'posted'"><list editable="bottom"><field name="name"/><field name="payment_date"/><field name="account_id"/><field name="payment_method"/><field name="amount"/><field name="state"/><button name="action_post" type="object" icon="fa-check" title="Valider" invisible="state != 'draft'"/><button name="action_cancel" type="object" icon="fa-times" title="Annuler" invisible="state != 'posted'"/></list></field></page><page string="Description"><field name="description"/></page></notebook>
        </sheet><chatter/></form></field>
    </record>
    <record id="view_agri_financial_transaction_search" model="ir.ui.view">
        <field name="name">agriculture.farm.financial.transaction.search</field><field name="model">agriculture.farm.financial.transaction</field>
        <field name="arch" type="xml"><search string="Mouvements financiers"><field name="reference"/><field name="name"/><field name="partner_id"/><field name="farm_id"/><field name="campaign_id"/><filter name="income" string="Recettes" domain="[('transaction_type','=','income')]"/><filter name="expense" string="Dépenses" domain="[('transaction_type','=','expense')]"/><filter name="transfer" string="Virements" domain="[('transaction_type','=','transfer')]"/><filter name="unpaid" string="Non réglés" domain="[('state','=','posted'),('payment_state','=','not_paid')]"/><filter name="partial" string="Partiellement réglés" domain="[('state','=','posted'),('payment_state','=','partial')]"/><filter name="posted" string="Validés" domain="[('state','=','posted')]"/><group><filter name="group_type" string="Type" context="{'group_by':'transaction_type'}"/><filter name="group_category" string="Catégorie" context="{'group_by':'category'}"/><filter name="group_farm" string="Exploitation" context="{'group_by':'farm_id'}"/><filter name="group_campaign" string="Campagne" context="{'group_by':'campaign_id'}"/><filter name="group_month" string="Mois" context="{'group_by':'date:month'}"/></group></search></field>
    </record>
    <record id="view_agri_financial_transaction_graph" model="ir.ui.view"><field name="name">agriculture.farm.financial.transaction.graph</field><field name="model">agriculture.farm.financial.transaction</field><field name="arch" type="xml"><graph string="Recettes et dépenses" type="bar"><field name="date" interval="month" type="row"/><field name="transaction_type" type="col"/><field name="amount" type="measure"/></graph></field></record>
    <record id="view_agri_financial_transaction_pivot" model="ir.ui.view"><field name="name">agriculture.farm.financial.transaction.pivot</field><field name="model">agriculture.farm.financial.transaction</field><field name="arch" type="xml"><pivot string="Analyse financière"><field name="farm_id" type="row"/><field name="category" type="row"/><field name="date" interval="month" type="col"/><field name="amount" type="measure"/></pivot></field></record>
    <record id="view_agri_financial_payment_form" model="ir.ui.view">
        <field name="name">agriculture.farm.financial.payment.form</field><field name="model">agriculture.farm.financial.payment</field>
        <field name="arch" type="xml"><form string="Règlement agricole"><header>
            <button name="action_post" type="object" string="Valider" class="oe_highlight" invisible="state != 'draft'"/>
            <button name="action_cancel" type="object" string="Annuler" invisible="state != 'posted'"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancelled"/>
        </header><sheet><group><field name="name"/><field name="transaction_id" readonly="1"/><field name="payment_date"/><field name="account_id"/><field name="payment_method"/><field name="amount"/><field name="currency_id"/><field name="note"/></group></sheet></form></field>
    </record>
    <record id="view_agri_financial_payment_list" model="ir.ui.view">
        <field name="name">agriculture.farm.financial.payment.list</field><field name="model">agriculture.farm.financial.payment</field>
        <field name="arch" type="xml"><list string="Règlements"><field name="name"/><field name="payment_date"/><field name="transaction_id"/><field name="account_id"/><field name="payment_method"/><field name="amount"/><field name="state"/></list></field>
    </record>
    <record id="action_agri_financial_transactions" model="ir.actions.act_window"><field name="name">Tous les mouvements</field><field name="res_model">agriculture.farm.financial.transaction</field><field name="view_mode">list,form,graph,pivot</field><field name="search_view_id" ref="view_agri_financial_transaction_search"/></record>
    <record id="action_agri_financial_income" model="ir.actions.act_window"><field name="name">Recettes</field><field name="res_model">agriculture.farm.financial.transaction</field><field name="view_mode">list,form,graph,pivot</field><field name="domain">[('transaction_type','=','income')]</field><field name="context">{'default_transaction_type':'income','default_category':'other_income'}</field><field name="search_view_id" ref="view_agri_financial_transaction_search"/></record>
    <record id="action_agri_financial_expense" model="ir.actions.act_window"><field name="name">Dépenses</field><field name="res_model">agriculture.farm.financial.transaction</field><field name="view_mode">list,form,graph,pivot</field><field name="domain">[('transaction_type','=','expense')]</field><field name="context">{'default_transaction_type':'expense','default_category':'other_expense'}</field><field name="search_view_id" ref="view_agri_financial_transaction_search"/></record>
    <record id="action_agri_financial_debts" model="ir.actions.act_window"><field name="name">Créances et dettes</field><field name="res_model">agriculture.farm.financial.transaction</field><field name="view_mode">list,form</field><field name="domain">[('state','=','posted'),('payment_state','in',('not_paid','partial')),('transaction_type','in',('income','expense'))]</field><field name="search_view_id" ref="view_agri_financial_transaction_search"/></record>
    <record id="action_agri_financial_transfers" model="ir.actions.act_window"><field name="name">Virements internes</field><field name="res_model">agriculture.farm.financial.transaction</field><field name="view_mode">list,form</field><field name="domain">[('transaction_type','=','transfer')]</field><field name="context">{'default_transaction_type':'transfer','default_category':'transfer'}</field></record>
</odoo>
