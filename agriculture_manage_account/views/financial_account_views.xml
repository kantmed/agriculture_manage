<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agri_financial_account_list" model="ir.ui.view">
        <field name="name">agriculture.farm.financial.account.list</field>
        <field name="model">agriculture.farm.financial.account</field>
        <field name="arch" type="xml">
            <list string="Comptes financiers" decoration-muted="not active">
                <field name="code"/><field name="name"/><field name="account_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id"/><field name="balance" sum="Solde total"/>
                <field name="journal_id" optional="hide"/><field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_agri_financial_account_form" model="ir.ui.view">
        <field name="name">agriculture.farm.financial.account.form</field>
        <field name="model">agriculture.farm.financial.account</field>
        <field name="arch" type="xml">
            <form string="Compte financier agricole">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="code"/><field name="account_type"/><field name="active"/></group>
                        <group><field name="company_id"/><field name="currency_id"/><field name="journal_id"/></group>
                    </group>
                    <group string="Situation"><field name="opening_balance"/><field name="balance"/></group>
                    <notebook>
                        <page string="Règlements"><field name="payment_ids" readonly="1"><list><field name="name"/><field name="payment_date"/><field name="transaction_id"/><field name="amount"/><field name="state"/></list></field></page>
                        <page string="Virements entrants"><field name="incoming_transfer_ids" readonly="1"><list><field name="reference"/><field name="date"/><field name="name"/><field name="amount"/><field name="account_id"/></list></field></page>
                        <page string="Virements sortants"><field name="outgoing_transfer_ids" readonly="1"><list><field name="reference"/><field name="date"/><field name="name"/><field name="amount"/><field name="destination_account_id"/></list></field></page>
                    </notebook>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="view_agri_financial_account_search" model="ir.ui.view">
        <field name="name">agriculture.farm.financial.account.search</field><field name="model">agriculture.farm.financial.account</field>
        <field name="arch" type="xml"><search string="Comptes financiers"><field name="name"/><field name="code"/><filter name="cash" string="Caisses" domain="[('account_type','=','cash')]"/><filter name="bank" string="Banques" domain="[('account_type','=','bank')]"/><filter name="active" string="Actifs" domain="[('active','=',True)]"/><group><filter name="group_type" string="Type" context="{'group_by':'account_type'}"/><filter name="group_company" string="Société" context="{'group_by':'company_id'}"/></group></search></field>
    </record>
    <record id="action_agri_financial_accounts" model="ir.actions.act_window">
        <field name="name">Comptes financiers</field><field name="res_model">agriculture.farm.financial.account</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_agri_financial_account_search"/>
    </record>
</odoo>
