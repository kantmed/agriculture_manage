<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_agriculture" model="ir.ui.view">
        <field name="name">sale.order.form.agriculture</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="agriculture_campaign_id" options="{'no_create': True}"/>
                <field name="agriculture_harvest_id" options="{'no_create': True}"/>
                <field name="agriculture_plot_id" options="{'no_create': True}"/>
                <field name="agriculture_farm_id" invisible="1"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_agriculture_financial_income"
                        type="object" string="Créer la recette agricole"
                        class="btn-secondary"
                        groups="agriculture_manage.group_farm_manager,agriculture_manage.group_farm_admin"
                        invisible="state not in ('sale', 'done') or agriculture_invoice_count &gt; 0"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_agriculture_invoices"
                        type="object" class="oe_stat_button" icon="fa-money"
                        invisible="agriculture_invoice_count == 0">
                    <field name="agriculture_invoice_count" widget="statinfo" string="Factures agricoles"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_agriculture" model="ir.ui.view">
        <field name="name">sale.order.list.agriculture</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="agriculture_campaign_id" optional="hide"/>
                <field name="agriculture_harvest_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="action_agriculture_sales_orders" model="ir.actions.act_window">
        <field name="name">Commandes agricoles</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('agriculture_campaign_id', '!=', False)]</field>
    </record>

    <record id="action_agriculture_sales_customers" model="ir.actions.act_window">
        <field name="name">Clients agricoles</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('customer_rank', '&gt;', 0)]</field>
    </record>
</odoo>
