<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_harvest_form_sales" model="ir.ui.view">
        <field name="name">agriculture.farm.harvest.form.sales</field>
        <field name="model">agriculture.farm.harvest</field>
        <field name="inherit_id" ref="agriculture_manage_crop.view_farm_harvest_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_sale_orders" type="object"
                            class="oe_stat_button" icon="fa-shopping-cart">
                        <field name="sale_order_count" widget="statinfo" string="Commandes clients"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
