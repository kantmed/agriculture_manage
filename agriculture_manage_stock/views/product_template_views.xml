<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_agriculture_stock" model="ir.ui.view">
        <field name="name">product.template.form.agriculture.stock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']//group" position="inside">
                <group string="Gestion agricole">
                    <field name="agriculture_category"/>
                    <field name="agriculture_is_input" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
