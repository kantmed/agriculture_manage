<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_agriculture" model="ir.ui.view">
        <field name="name">stock.picking.form.agriculture</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="farm_id" options="{'no_create': True}"/>
                <field name="campaign_plot_id" domain="[('campaign_id.farm_id', '=', farm_id)]" options="{'no_create': True}"/>
                <field name="agriculture_operation_id" domain="[('campaign_id.farm_id', '=', farm_id)]" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_list_agriculture" model="ir.ui.view">
        <field name="name">stock.picking.list.agriculture</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="farm_id" optional="show"/>
                <field name="campaign_plot_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="action_agriculture_stock_picking" model="ir.actions.act_window">
        <field name="name">Mouvements agricoles</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('farm_id', '!=', False)]</field>
        <field name="context">{'default_farm_id': False}</field>
    </record>
</odoo>
