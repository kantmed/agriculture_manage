<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_form_agriculture" model="ir.ui.view">
        <field name="name">stock.warehouse.form.agriculture</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="farm_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="action_agriculture_stock_warehouse" model="ir.actions.act_window">
        <field name="name">Magasins agricoles</field>
        <field name="res_model">stock.warehouse</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('farm_id', '!=', False)]</field>
        <field name="context">{'default_company_id': allowed_company_ids and allowed_company_ids[0]}</field>
    </record>
</odoo>
