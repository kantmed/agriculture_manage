<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_operation_form_project" model="ir.ui.view">
        <field name="name">agriculture.farm.operation.form.project</field>
        <field name="model">agriculture.farm.operation</field>
        <field name="inherit_id" ref="agriculture_manage_crop.view_farm_operation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='campaign_id']" position="attributes">
                <attribute name="invisible">project_id</attribute>
            </xpath>
            <xpath expr="//field[@name='campaign_id']" position="after">
                <field name="project_id" invisible="campaign_id" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='plot_id']" position="attributes">
                <attribute name="domain">[('farm_id', '=', farm_id)]</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_farm_operation_list_project" model="ir.ui.view">
        <field name="name">agriculture.farm.operation.list.project</field>
        <field name="model">agriculture.farm.operation</field>
        <field name="inherit_id" ref="agriculture_manage_crop.view_farm_operation_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='campaign_id']" position="after">
                <field name="project_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
