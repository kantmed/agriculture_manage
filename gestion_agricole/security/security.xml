<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_gestion_agricole" model="ir.module.category">
        <field name="name">Gestion Agricole</field>
        <field name="description">
            Gestion des exploitations et des activités agricoles
        </field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_gestion_agricole" model="res.groups.privilege">
        <field name="name">Gestion Agricole</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_gestion_agricole"/>
    </record>

    <record id="group_gest_agri_user" model="res.groups">
        <field name="name">Utilisateur agricole</field>
        <field name="privilege_id" ref="res_groups_privilege_gestion_agricole"/>
    </record>

    <record id="group_gest_agri_manager" model="res.groups">
        <field name="name">Responsable agricole</field>
        <field name="privilege_id" ref="res_groups_privilege_gestion_agricole"/>
        <field name="implied_ids" eval="[(4, ref('group_gest_agri_user'))]"/>
    </record>

    <record id="group_gest_agri_admin" model="res.groups">
        <field name="name">Administrateur agricole</field>
        <field name="privilege_id" ref="res_groups_privilege_gestion_agricole"/>
        <field name="implied_ids" eval="[(4, ref('group_gest_agri_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>

