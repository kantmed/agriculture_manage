    <record id="view_gest_agri_sanitary_intervention_form" model="ir.ui.view">
        <field name="name">gest_agri.sanitary.intervention.form</field>
        <field name="model">gest_agri.sanitary.intervention</field>
        <field name="arch" type="xml">
            <form string="Intervention sanitaire">
                <header>
                    <button name="action_done" string="Terminer" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancelled"/>
