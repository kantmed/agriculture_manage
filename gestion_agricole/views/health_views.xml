    <record id="view_gest_agri_vaccination_search" model="ir.ui.view">
        <field name="name">gest_agri.vaccination.search</field>
        <field name="model">gest_agri.vaccination</field>
        <field name="arch" type="xml">
            <search string="Vaccinations">
                <field name="name"/>
                <field name="animal_id"/>
                <field name="lot_id"/>
                <field name="vaccine_name"/>
                <filter string="Réalisées" name="done" domain="[('state','=','done')]"/>
                <filter string="Annulées" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Rappel à venir" name="due_upcoming" domain="[('state','=','done'),('next_due_date','!=',False),('next_due_date','&gt;=',datetime.date.today())]"/>
                <filter string="Rappel dépassé" name="due_overdue" domain="[('state','=','done'),('next_due_date','!=',False),('next_due_date','&lt;',datetime.date.today())]"/>
                <separator/>
                <group>
                    <filter string="Animal" name="group_animal" context="{'group_by':'animal_id'}"/>
                    <filter string="Lot" name="group_lot" context="{'group_by':'lot_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_vaccination" model="ir.actions.act_window">
        <field name="name">Vaccinations</field>
        <field name="res_model">gest_agri.vaccination</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_gest_agri_vaccination_deadlines" model="ir.actions.act_window">
        <field name="name">Rappels vaccinaux à venir</field>
        <field name="res_model">gest_agri.vaccination</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','done'),('next_due_date','!=',False)]</field>
        <field name="context">{'search_default_due_upcoming': 1}</field>
    </record>

    <!-- Traitements -->
    <record id="view_gest_agri_animal_treatment_list" model="ir.ui.view">
        <field name="name">gest_agri.animal.treatment.list</field>
        <field name="model">gest_agri.animal.treatment</field>
        <field name="arch" type="xml">
            <list string="Traitements vétérinaires">
                <field name="name"/>
                <field name="animal_id"/>
                <field name="lot_id"/>
                <field name="product_name"/>
                <field name="start_date"/>
                <field name="end_date_planned"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_animal_treatment_form" model="ir.ui.view">
        <field name="name">gest_agri.animal.treatment.form</field>
        <field name="model">gest_agri.animal.treatment</field>
        <field name="arch" type="xml">
            <form string="Traitement vétérinaire">
                <header>
                    <button name="action_start" string="Démarrer" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_done" string="Terminer" type="object" invisible="state != 'in_progress'" class="btn-primary"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Référence"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="animal_id"/>
                            <field name="lot_id"/>
                        </group>
                        <group>
                            <field name="product_name"/>
                            <field name="dosage"/>
                            <field name="uom_id"/>
                            <field name="administration_route"/>
                            <field name="frequency"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date_planned"/>
                            <field name="end_date_actual"/>
                        </group>
                        <group>
                            <field name="veterinarian_id"/>
                            <field name="responsible_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="notes"/>
                    </group>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_animal_treatment_search" model="ir.ui.view">
        <field name="name">gest_agri.animal.treatment.search</field>
        <field name="model">gest_agri.animal.treatment</field>
        <field name="arch" type="xml">
            <search string="Traitements vétérinaires">
                <field name="name"/>
                <field name="animal_id"/>
                <field name="lot_id"/>
                <field name="product_name"/>
                <filter string="En cours" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Terminés" name="done" domain="[('state','=','done')]"/>
                <filter string="Annulés" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Fin prévue à venir" name="end_upcoming" domain="[('state','=','in_progress'),('end_date_planned','!=',False),('end_date_planned','&gt;=',datetime.date.today())]"/>
                <filter string="Fin prévue dépassée" name="end_overdue" domain="[('state','=','in_progress'),('end_date_planned','!=',False),('end_date_planned','&lt;',datetime.date.today())]"/>
                <separator/>
                <group>
                    <filter string="Animal" name="group_animal" context="{'group_by':'animal_id'}"/>
                    <filter string="Lot" name="group_lot" context="{'group_by':'lot_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_animal_treatment" model="ir.actions.act_window">
        <field name="name">Traitements vétérinaires</field>
        <field name="res_model">gest_agri.animal.treatment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Interventions sanitaires -->
