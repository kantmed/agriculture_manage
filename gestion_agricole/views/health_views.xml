    <record id="view_gest_agri_sanitary_intervention_search" model="ir.ui.view">
        <field name="name">gest_agri.sanitary.intervention.search</field>
        <field name="model">gest_agri.sanitary.intervention</field>
        <field name="arch" type="xml">
            <search string="Interventions sanitaires">
                <field name="name"/>
                <field name="lot_id"/>
                <field name="intervention_type"/>
                <filter string="Terminées" name="done" domain="[('state','=','done')]"/>
                <filter string="Annulées" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by':'intervention_type'}"/>
                    <filter string="Lot" name="group_lot" context="{'group_by':'lot_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_sanitary_intervention" model="ir.actions.act_window">
        <field name="name">Interventions sanitaires</field>
        <field name="res_model">gest_agri.sanitary.intervention</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Animaux : boutons intelligents santé -->
    <record id="view_gest_agri_animal_form_health" model="ir.ui.view">
        <field name="name">gest_agri.animal.form.health</field>
        <field name="model">gest_agri.animal</field>
        <field name="inherit_id" ref="gestion_agricole.view_gest_agri_animal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="button_box_health">
                    <button name="action_view_health_records" type="object" class="oe_stat_button" icon="fa-heartbeat">
                        <field name="health_record_count" widget="statinfo" string="Dossiers"/>
                    </button>
                    <button name="action_view_consultations" type="object" class="oe_stat_button" icon="fa-stethoscope">
                        <field name="consultation_count" widget="statinfo" string="Consultations"/>
                    </button>
                    <button name="action_view_vaccinations" type="object" class="oe_stat_button" icon="fa-medkit">
                        <field name="vaccination_count" widget="statinfo" string="Vaccinations"/>
                    </button>
                    <button name="action_view_treatments" type="object" class="oe_stat_button" icon="fa-flask">
                        <field name="treatment_count" widget="statinfo" string="Traitements"/>
                    </button>
                </div>
                <group string="Échéances sanitaires">
                    <group>
                        <field name="next_vaccination_due_date"/>
                        <field name="next_control_date"/>
                    </group>
                    <group>
                        <field name="has_overdue_sanitary_deadline"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Lots : boutons intelligents santé -->
    <record id="view_gest_agri_animal_lot_form_health" model="ir.ui.view">
        <field name="name">gest_agri.animal.lot.form.health</field>
        <field name="model">gest_agri.animal.lot</field>
        <field name="inherit_id" ref="gestion_agricole.view_gest_agri_animal_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="button_box_health_lot">
                    <button name="action_view_sanitary_interventions" type="object" class="oe_stat_button" icon="fa-shield">
                        <field name="sanitary_intervention_count" widget="statinfo" string="Interventions"/>
                    </button>
                    <field name="consultation_count" invisible="1"/>
                    <field name="vaccination_count" invisible="1"/>
                    <field name="treatment_count" invisible="1"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_gestion_agricole_sante_animale"
              name="Santé animale"
              parent="menu_gestion_agricole_elevage"
              sequence="90"/>
