    </record>

    <record id="view_gest_agri_vaccination_form" model="ir.ui.view">
        <field name="name">gest_agri.vaccination.form</field>
        <field name="model">gest_agri.vaccination</field>
        <field name="arch" type="xml">
            <form string="Vaccination">
                <header>
                    <button name="action_done" string="Réaliser" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Référence"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="animal_id"/>
                            <field name="lot_id"/>
                        </group>
                        <group>
                            <field name="vaccine_name"/>
                            <field name="vaccine_lot"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="vaccination_date"/>
                            <field name="next_due_date"/>
                        </group>
                        <group>
                            <field name="dose"/>
                            <field name="uom_id"/>
                            <field name="administration_route"/>
                        </group>
                    </group>
                    <group>
                        <field name="veterinarian_id"/>
