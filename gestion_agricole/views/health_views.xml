<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Maladies -->
    <record id="view_gest_agri_animal_disease_list" model="ir.ui.view">
        <field name="name">gest_agri.animal.disease.list</field>
        <field name="model">gest_agri.animal.disease</field>
        <field name="arch" type="xml">
            <list string="Maladies animales">
                <field name="code"/>
                <field name="name"/>
                <field name="severity"/>
                <field name="contagious"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_animal_disease_form" model="ir.ui.view">
        <field name="name">gest_agri.animal.disease.form</field>
        <field name="model">gest_agri.animal.disease</field>
        <field name="arch" type="xml">
            <form string="Maladie animale">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nom"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="severity"/>
                            <field name="contagious"/>
                        </group>
                        <group>
                            <field name="species_ids" widget="many2many_tags"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="symptoms"/>
                        <field name="recommendations"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_animal_disease_search" model="ir.ui.view">
        <field name="name">gest_agri.animal.disease.search</field>
        <field name="model">gest_agri.animal.disease</field>
        <field name="arch" type="xml">
            <search string="Maladies animales">
                <field name="name"/>
                <field name="code"/>
                <field name="species_ids"/>
                <filter string="Contagieuses" name="contagious" domain="[('contagious','=',True)]"/>
                <filter string="Archivées" name="archived" domain="[('active','=',False)]"/>
                <separator/>
                <group>
                    <filter string="Gravité" name="group_severity" context="{'group_by':'severity'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_animal_disease" model="ir.actions.act_window">
        <field name="name">Maladies animales</field>
        <field name="res_model">gest_agri.animal.disease</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Dossiers sanitaires -->
    <record id="view_gest_agri_animal_health_list" model="ir.ui.view">
        <field name="name">gest_agri.animal.health.list</field>
        <field name="model">gest_agri.animal.health</field>
        <field name="arch" type="xml">
            <list string="Dossiers sanitaires">
                <field name="name"/>
                <field name="animal_id"/>
                <field name="farm_id"/>
                <field name="observation_date"/>
                <field name="disease_id"/>
                <field name="severity"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_animal_health_form" model="ir.ui.view">
        <field name="name">gest_agri.animal.health.form</field>
        <field name="model">gest_agri.animal.health</field>
        <field name="arch" type="xml">
            <form string="Dossier sanitaire">
                <header>
                    <button name="action_validate" string="Valider" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Référence"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="animal_id"/>
                            <field name="farm_id" readonly="1"/>
                            <field name="site_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="observation_date"/>
                            <field name="declaration_date"/>
                            <field name="disease_id"/>
                            <field name="severity"/>
                        </group>
                    </group>
                    <group>
                        <field name="symptoms"/>
                        <field name="notes"/>
                    </group>
                    <group>
                        <field name="veterinarian_id"/>
                        <field name="responsible_id"/>
                    </group>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_animal_health_search" model="ir.ui.view">
        <field name="name">gest_agri.animal.health.search</field>
        <field name="model">gest_agri.animal.health</field>
        <field name="arch" type="xml">
            <search string="Dossiers sanitaires">
                <field name="name"/>
                <field name="animal_id"/>
                <field name="disease_id"/>
                <field name="farm_id"/>
                <field name="site_id"/>
                <filter string="Brouillons" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Validés" name="validated" domain="[('state','=','validated')]"/>
                <filter string="Annulés" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Gravité élevée" name="high_severity" domain="[('severity','in',['high','critical'])]"/>
                <separator/>
                <group>
                    <filter string="Animal" name="group_animal" context="{'group_by':'animal_id'}"/>
                    <filter string="Maladie" name="group_disease" context="{'group_by':'disease_id'}"/>
                    <filter string="Exploitation" name="group_farm" context="{'group_by':'farm_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_animal_health" model="ir.actions.act_window">
        <field name="name">Dossiers sanitaires</field>
        <field name="res_model">gest_agri.animal.health</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Consultations vétérinaires -->
    <record id="view_gest_agri_veterinary_consultation_list" model="ir.ui.view">
        <field name="name">gest_agri.veterinary.consultation.list</field>
        <field name="model">gest_agri.veterinary.consultation</field>
        <field name="arch" type="xml">
            <list string="Consultations vétérinaires">
                <field name="name"/>
                <field name="consultation_datetime"/>
                <field name="animal_id"/>
                <field name="lot_id"/>
                <field name="veterinarian_id"/>
                <field name="next_control_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_veterinary_consultation_form" model="ir.ui.view">
        <field name="name">gest_agri.veterinary.consultation.form</field>
        <field name="model">gest_agri.veterinary.consultation</field>
        <field name="arch" type="xml">
            <form string="Consultation vétérinaire">
                <header>
                    <button name="action_done" string="Réaliser" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Référence"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="animal_id"/>
                            <field name="lot_id"/>
                            <field name="farm_id" readonly="1"/>
                            <field name="site_id"/>
                        </group>
                        <group>
                            <field name="consultation_datetime"/>
                            <field name="veterinarian_id"/>
                            <field name="next_control_date"/>
                            <field name="responsible_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="symptoms"/>
                        <field name="diagnosis"/>
                        <field name="acts"/>
                        <field name="recommendations"/>
                        <field name="notes"/>
                    </group>
                    <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_veterinary_consultation_search" model="ir.ui.view">
        <field name="name">gest_agri.veterinary.consultation.search</field>
        <field name="model">gest_agri.veterinary.consultation</field>
        <field name="arch" type="xml">
            <search string="Consultations vétérinaires">
                <field name="name"/>
                <field name="animal_id"/>
                <field name="lot_id"/>
                <field name="veterinarian_id"/>
                <field name="farm_id"/>
                <filter string="Réalisées" name="done" domain="[('state','=','done')]"/>
                <filter string="Annulées" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Contrôle à venir" name="control_upcoming" domain="[('state','=','done'),('next_control_date','!=',False),('next_control_date','&gt;=',datetime.date.today())]"/>
                <filter string="Contrôle dépassé" name="control_overdue" domain="[('state','=','done'),('next_control_date','!=',False),('next_control_date','&lt;',datetime.date.today())]"/>
                <separator/>
                <group>
                    <filter string="Animal" name="group_animal" context="{'group_by':'animal_id'}"/>
                    <filter string="Lot" name="group_lot" context="{'group_by':'lot_id'}"/>
                    <filter string="Vétérinaire" name="group_vet" context="{'group_by':'veterinarian_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_veterinary_consultation" model="ir.actions.act_window">
        <field name="name">Consultations vétérinaires</field>
        <field name="res_model">gest_agri.veterinary.consultation</field>
        <field name="view_mode">list,form</field>
    </record>

