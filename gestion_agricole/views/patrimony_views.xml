<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sites -->
    <record id="view_gest_agri_site_list" model="ir.ui.view">
        <field name="name">gest_agri.site.list</field>
        <field name="model">gest_agri.site</field>
        <field name="arch" type="xml">
            <list string="Sites">
                <field name="name"/>
                <field name="code"/>
                <field name="farm_id"/>
                <field name="area_ha" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="sequence" widget="handle"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_site_form" model="ir.ui.view">
        <field name="name">gest_agri.site.form</field>
        <field name="model">gest_agri.site</field>
        <field name="arch" type="xml">
            <form string="Site">
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Nom du site"/>
                        <h1><field name="name" placeholder="Ex. Site Nord"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="farm_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="area_ha"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parcelles" name="plots">
                            <field name="plot_ids" context="{'default_farm_id': farm_id, 'default_site_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="area" sum="Total"/>
                                    <field name="active" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bâtiments" name="buildings">
                            <field name="building_ids" context="{'default_farm_id': farm_id, 'default_site_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="building_type_id"/>
                                    <field name="area"/>
                                    <field name="active" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Infrastructures" name="infrastructures">
                            <field name="infrastructure_ids" context="{'default_farm_id': farm_id, 'default_site_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="infrastructure_kind"/>
                                    <field name="length_m"/>
                                    <field name="active" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sources d'eau" name="water_sources">
                            <field name="water_source_ids" context="{'default_farm_id': farm_id, 'default_site_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="source_type"/>
                                    <field name="capacity_m3_day"/>
                                    <field name="active" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Informations complémentaires..."/>
                        </page>
                        <page string="Notes internes" name="notes">
                            <field name="notes" placeholder="Observations et informations complémentaires..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_site_search" model="ir.ui.view">
        <field name="name">gest_agri.site.search</field>
        <field name="model">gest_agri.site</field>
        <field name="arch" type="xml">
            <search string="Sites">
                <field name="name"/>
                <field name="code"/>
                <field name="farm_id"/>
                <filter name="active" string="Actifs" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archivés" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_farm" string="Exploitation" context="{'group_by': 'farm_id'}"/>
                    <filter name="group_company" string="Société" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_site" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">gest_agri.site</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier site d'exploitation.</p>
        </field>
    </record>

    <menuitem id="menu_gest_agri_site" name="Sites"
              parent="menu_gestion_agricole_exploitations"
              action="action_gest_agri_site" sequence="20"
              groups="gestion_agricole.group_gest_agri_user"/>

    <!-- Parcelles -->
    <record id="view_gest_agri_plot_list" model="ir.ui.view">
        <field name="name">gest_agri.plot.list</field>
        <field name="model">gest_agri.plot</field>
        <field name="arch" type="xml">
            <list string="Parcelles">
                <field name="name"/>
                <field name="code"/>
                <field name="farm_id"/>
                <field name="site_id"/>
                <field name="area" sum="Total"/>
                <field name="soil_type_id"/>
                <field name="irrigation_type_id"/>
                <field name="crop_type_id"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_plot_form" model="ir.ui.view">
        <field name="name">gest_agri.plot.form</field>
        <field name="model">gest_agri.plot</field>
        <field name="arch" type="xml">
            <form string="Parcelle">
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Nom de la parcelle"/>
                        <h1><field name="name" placeholder="Ex. Parcelle A1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="farm_id"/>
                            <field name="site_id" domain="[('farm_id', '=', farm_id)]"/>
                            <field name="area"/>
                        </group>
                        <group>
                            <field name="soil_type_id"/>
                            <field name="irrigation_type_id"/>
                            <field name="crop_type_id"/>
                            <field name="state"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Caractéristiques agronomiques">
                        <group>
                            <field name="ph_min"/>
                            <field name="ph_max"/>
                        </group>
                        <group>
                            <field name="slope_percent"/>
                        </group>
                    </group>
                    <group string="Géolocalisation">
                        <group>
                            <field name="latitude"/>
                        </group>
                        <group>
                            <field name="longitude"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Observations agronomiques..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_plot_search" model="ir.ui.view">
        <field name="name">gest_agri.plot.search</field>
        <field name="model">gest_agri.plot</field>
        <field name="arch" type="xml">
            <search string="Parcelles">
                <field name="name"/>
                <field name="code"/>
                <field name="farm_id"/>
                <field name="site_id"/>
                <field name="soil_type_id"/>
                <field name="crop_type_id"/>
                <field name="state"/>
                <filter name="active" string="Actives" domain="[('active', '=', True)]"/>
                <filter name="available" string="Disponibles" domain="[('state', '=', 'available')]"/>
                <filter name="cultivated" string="Cultivées" domain="[('state', '=', 'cultivated')]"/>
                <filter name="fallow" string="En jachère" domain="[('state', '=', 'fallow')]"/>
                <group>
                    <filter name="group_state" string="Statut" context="{'group_by': 'state'}"/>
                </group>
                <filter name="inactive" string="Archivées" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_farm" string="Exploitation" context="{'group_by': 'farm_id'}"/>
                    <filter name="group_site" string="Site" context="{'group_by': 'site_id'}"/>
                    <filter name="group_soil" string="Type de sol" context="{'group_by': 'soil_type_id'}"/>
                    <filter name="group_crop" string="Type de culture" context="{'group_by': 'crop_type_id'}"/>
                    <filter name="group_irrigation" string="Type d'irrigation" context="{'group_by': 'irrigation_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_plot" model="ir.actions.act_window">
        <field name="name">Parcelles</field>
        <field name="res_model">gest_agri.plot</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre première parcelle.</p>
        </field>
    </record>

    <menuitem id="menu_gest_agri_plot" name="Parcelles"
              parent="menu_gestion_agricole_exploitations"
              action="action_gest_agri_plot" sequence="30"
              groups="gestion_agricole.group_gest_agri_user"/>

