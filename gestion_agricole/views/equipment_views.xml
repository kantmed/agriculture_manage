<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- ÉQUIPEMENTS -->
    <!-- ============================================================ -->
    <record id="view_gest_agri_equipment_list" model="ir.ui.view">
        <field name="name">gest_agri.equipment.list</field>
        <field name="model">gest_agri.equipment</field>
        <field name="arch" type="xml">
            <list string="Équipements">
                <field name="reference"/>
                <field name="name"/>
                <field name="equipment_type_id"/>
                <field name="farm_id"/>
                <field name="site_id"/>
                <field name="state" widget="badge"/>
                <field name="hour_meter"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_equipment_form" model="ir.ui.view">
        <field name="name">gest_agri.equipment.form</field>
        <field name="model">gest_agri.equipment</field>
        <field name="arch" type="xml">
            <form string="Équipement agricole">
                <header>
                    <button name="action_available" string="Rendre disponible" type="object" invisible="state not in ('draft','maintenance','out_of_service')" class="btn-primary"/>
                    <button name="action_in_use" string="Mettre en utilisation" type="object" invisible="state != 'available'" class="btn-primary"/>
                    <button name="action_maintenance" string="Mettre en maintenance" type="object" invisible="state not in ('available','in_use','out_of_service')"/>
                    <button name="action_out_of_service" string="Hors service" type="object" invisible="state not in ('available','in_use','maintenance')"/>
                    <button name="action_retire" string="Retirer du service" type="object" invisible="state not in ('available','out_of_service','maintenance')" groups="gestion_agricole.group_gest_agri_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,available,in_use,maintenance,out_of_service,retired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_usages" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="usage_count" widget="statinfo" string="Utilisations"/>
                        </button>
                        <button name="action_view_maintenances" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo" string="Maintenances"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Désignation"/>
                        <h1><field name="name"/></h1>
                        <h2><field name="reference" readonly="1"/></h2>
                    </div>
                    <notebook>
                        <page string="Informations générales" name="general">
                            <group>
                                <group>
                                    <field name="equipment_type_id"/>
                                    <field name="brand"/>
                                    <field name="model"/>
                                    <field name="serial_number"/>
                                    <field name="registration_number"/>
                                    <field name="active" invisible="1"/>
                                    <field name="sequence"/>
                                </group>
                                <group>
                                    <field name="description"/>
                                </group>
                            </group>
                        </page>
                        <page string="Acquisition" name="acquisition">
                            <group>
                                <group>
                                    <field name="acquisition_date"/>
                                    <field name="acquisition_price"/>
                                    <field name="supplier_id"/>
                                </group>
                                <group>
                                    <field name="commissioning_date"/>
                                    <field name="warranty_end_date"/>
                                    <field name="condition"/>
                                </group>
                            </group>
                        </page>
                        <page string="Affectation et localisation" name="location">
                            <group>
                                <group>
                                    <field name="farm_id"/>
                                    <field name="site_id"/>
                                    <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                                </group>
                                <group>
                                    <field name="location"/>
                                </group>
                            </group>
                        </page>
                        <page string="Compteurs" name="counters">
                            <group>
                                <group>
                                    <field name="hour_meter"/>
                                    <field name="odometer"/>
                                    <field name="cycle_counter"/>
                                </group>
                                <group>
                                    <field name="last_usage_date" readonly="1"/>
                                    <field name="last_maintenance_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Utilisations" name="usages">
                            <field name="usage_ids" context="{'default_equipment_id': id}">
                                <list create="false" edit="false">
                                    <field name="name"/>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="duration_hours"/>
                                    <field name="operator_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                            <button name="action_view_usages" type="object" class="btn btn-link" string="Ouvrir toutes les utilisations"/>
                        </page>
                        <page string="Maintenance" name="maintenance">
                            <field name="maintenance_ids" context="{'default_equipment_id': id}">
                                <list create="false" edit="false">
                                    <field name="name"/>
                                    <field name="maintenance_type"/>
                                    <field name="planned_date"/>
                                    <field name="realized_date"/>
                                    <field name="state" widget="badge"/>
                                    <field name="total_cost"/>
                                </list>
                            </field>
                            <button name="action_view_maintenances" type="object" class="btn btn-link" string="Ouvrir toutes les maintenances"/>
                            <group>
                                <group>
                                    <field name="next_maintenance_date"/>
                                    <field name="next_maintenance_hours"/>
                                    <field name="next_maintenance_km"/>
                                </group>
                                <group>
                                    <field name="total_maintenance_cost" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Observations et informations complémentaires..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_equipment_search" model="ir.ui.view">
        <field name="name">gest_agri.equipment.search</field>
        <field name="model">gest_agri.equipment</field>
        <field name="arch" type="xml">
            <search string="Équipements">
                <field name="name"/>
                <field name="reference"/>
                <field name="equipment_type_id"/>
                <field name="farm_id"/>
                <field name="serial_number"/>
                <filter string="Disponibles" name="available" domain="[('state','=','available')]"/>
                <filter string="En maintenance" name="maintenance" domain="[('state','=','maintenance')]"/>
                <filter string="Archivés" name="archived" domain="[('active','=',False)]"/>
                <separator/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by':'equipment_type_id'}"/>
                    <filter string="État" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Exploitation" name="group_farm" context="{'group_by':'farm_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_equipment" model="ir.actions.act_window">
        <field name="name">Équipements</field>
        <field name="res_model">gest_agri.equipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gest_agri_equipment"
              name="Équipements"
              parent="menu_gestion_agricole_materiel"
              action="action_gest_agri_equipment"
              sequence="10"/>

    <!-- ============================================================ -->
    <!-- UTILISATIONS -->
    <!-- ============================================================ -->
    <record id="view_gest_agri_equipment_usage_list" model="ir.ui.view">
        <field name="name">gest_agri.equipment.usage.list</field>
        <field name="model">gest_agri.equipment.usage</field>
        <field name="arch" type="xml">
            <list string="Utilisations">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="farm_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="duration_hours"/>
                <field name="operator_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_equipment_usage_form" model="ir.ui.view">
        <field name="name">gest_agri.equipment.usage.form</field>
        <field name="model">gest_agri.equipment.usage</field>
        <field name="arch" type="xml">
            <form string="Utilisation de matériel">
                <header>
                    <button name="action_done" string="Terminer" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Référence"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="farm_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="operator_id"/>
                            <field name="plot_id"/>
                            <field name="intervention_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="duration_hours" readonly="1"/>
                        </group>
                        <group>
                            <field name="counter_start"/>
                            <field name="counter_end"/>
                            <field name="counter_delta" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_equipment_usage_search" model="ir.ui.view">
        <field name="name">gest_agri.equipment.usage.search</field>
        <field name="model">gest_agri.equipment.usage</field>
        <field name="arch" type="xml">
            <search string="Utilisations">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="farm_id"/>
                <filter string="Brouillons" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Terminées" name="done" domain="[('state','=','done')]"/>
                <filter string="Annulées" name="cancelled" domain="[('state','=','cancelled')]"/>
                <group>
                    <filter string="Équipement" name="group_equipment" context="{'group_by':'equipment_id'}"/>
                    <filter string="État" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_equipment_usage" model="ir.actions.act_window">
        <field name="name">Utilisations</field>
        <field name="res_model">gest_agri.equipment.usage</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gest_agri_equipment_usage"
              name="Utilisations"
              parent="menu_gestion_agricole_materiel"
              action="action_gest_agri_equipment_usage"
              sequence="20"/>

    <!-- ============================================================ -->
    <!-- MAINTENANCES -->
    <!-- ============================================================ -->
    <record id="view_gest_agri_equipment_maintenance_list" model="ir.ui.view">
        <field name="name">gest_agri.equipment.maintenance.list</field>
        <field name="model">gest_agri.equipment.maintenance</field>
        <field name="arch" type="xml">
            <list string="Maintenances">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="maintenance_type"/>
                <field name="planned_date"/>
                <field name="realized_date"/>
                <field name="state" widget="badge"/>
                <field name="total_cost"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_equipment_maintenance_form" model="ir.ui.view">
        <field name="name">gest_agri.equipment.maintenance.form</field>
        <field name="model">gest_agri.equipment.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance de matériel">
                <header>
                    <button name="action_plan" string="Planifier" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_start" string="Démarrer" type="object" invisible="state != 'planned'" class="btn-primary"/>
                    <button name="action_done" string="Terminer" type="object" invisible="state != 'in_progress'" class="btn-primary"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Référence"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="farm_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="maintenance_type"/>
                        </group>
                        <group>
                            <field name="planned_date"/>
                            <field name="realized_date"/>
                            <field name="duration_hours"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="provider_id"/>
                            <field name="technician_id"/>
                        </group>
                        <group>
                            <field name="counter_at_maintenance"/>
                        </group>
                    </group>
                    <group>
                        <field name="problem_description"/>
                        <field name="work_description"/>
                        <field name="parts_used"/>
                    </group>
                    <group>
                        <group>
                            <field name="parts_cost"/>
                            <field name="labor_cost"/>
                            <field name="external_cost"/>
                            <field name="total_cost" readonly="1"/>
                        </group>
                        <group>
                            <field name="next_due_date"/>
                            <field name="next_due_hours"/>
                            <field name="next_due_km"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_equipment_maintenance_search" model="ir.ui.view">
        <field name="name">gest_agri.equipment.maintenance.search</field>
        <field name="model">gest_agri.equipment.maintenance</field>
        <field name="arch" type="xml">
            <search string="Maintenances">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="farm_id"/>
                <filter string="Planifiées" name="planned" domain="[('state','=','planned')]"/>
                <filter string="En cours" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Terminées" name="done" domain="[('state','=','done')]"/>
                <filter string="Annulées" name="cancelled" domain="[('state','=','cancelled')]"/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by':'maintenance_type'}"/>
                    <filter string="État" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Équipement" name="group_equipment" context="{'group_by':'equipment_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_equipment_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenances</field>
        <field name="res_model">gest_agri.equipment.maintenance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gest_agri_equipment_maintenance"
              name="Maintenances"
              parent="menu_gestion_agricole_materiel"
              action="action_gest_agri_equipment_maintenance"
              sequence="30"/>
</odoo>