    <!-- Types d'exploitation -->
    <record id="view_gest_agri_farm_type_list" model="ir.ui.view">
        <field name="name">gest_agri.farm.type.list</field>
        <field name="model">gest_agri.farm.type</field>
        <field name="arch" type="xml">
            <list string="Types d'exploitation">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="sequence" widget="handle"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_farm_type_form" model="ir.ui.view">
        <field name="name">gest_agri.farm.type.form</field>
        <field name="model">gest_agri.farm.type</field>
        <field name="arch" type="xml">
            <form string="Types d'exploitation">
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Nom"/>
                        <h1><field name="name" placeholder="Type d'exploitation"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description ou notes internes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_farm_type_search" model="ir.ui.view">
        <field name="name">gest_agri.farm.type.search</field>
        <field name="model">gest_agri.farm.type</field>
        <field name="arch" type="xml">
            <search string="Types d'exploitation">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="active" string="Actifs" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archivés" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_company" string="Société" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_farm_type" model="ir.actions.act_window">
        <field name="name">Types d'exploitation</field>
        <field name="res_model">gest_agri.farm.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier type d'exploitation.</p>
        </field>
    </record>

