<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- TRAVAILLEURS -->
    <!-- ============================================================ -->
    <record id="view_gest_agri_worker_list" model="ir.ui.view">
        <field name="name">gest_agri.worker.list</field>
        <field name="model">gest_agri.worker</field>
        <field name="arch" type="xml">
            <list string="Travailleurs">
                <field name="reference"/>
                <field name="full_name"/>
                <field name="farm_id"/>
                <field name="function"/>
                <field name="worker_type"/>
                <field name="state" widget="badge"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_worker_form" model="ir.ui.view">
        <field name="name">gest_agri.worker.form</field>
        <field name="model">gest_agri.worker</field>
        <field name="arch" type="xml">
            <form string="Travailleur agricole">
                <header>
                    <button name="action_activate" string="Activer" type="object" invisible="state not in ('draft','suspended')" class="btn-primary"/>
                    <button name="action_suspend" string="Suspendre" type="object" invisible="state != 'active'"/>
                    <button name="action_exit" string="Sortir" type="object" invisible="state not in ('active','suspended')" groups="gestion_agricole.group_gest_agri_manager"/>
                    <button name="action_reset_draft" string="Réinitialiser" type="object" invisible="state != 'exited'" groups="gestion_agricole.group_gest_agri_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,suspended,exited"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="assignment_count" widget="statinfo" string="Affectations"/>
                        </button>
                        <button name="action_view_times" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="time_count" widget="statinfo" string="Feuilles"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Nom"/>
                        <h1><field name="name"/></h1>
                        <h2><field name="reference" readonly="1"/></h2>
                    </div>
                    <notebook>
                        <page string="Informations" name="info">
                            <group>
                                <group>
                                    <field name="firstname"/>
                                    <field name="full_name" readonly="1"/>
                                    <field name="birth_date"/>
                                    <field name="function"/>
                                    <field name="worker_type"/>
                                </group>
                                <group>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="address"/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="entry_date"/>
                                    <field name="exit_date"/>
                                </group>
                                <group>
                                    <field name="partner_id"/>
                                    <field name="user_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Rattachement" name="org">
                            <group>
                                <group>
                                    <field name="farm_id"/>
                                    <field name="site_id"/>
                                    <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                                </group>
                                <group>
                                    <field name="team_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Statistiques" name="stats">
                            <group>
                                <group>
                                    <field name="assignment_count" readonly="1"/>
                                    <field name="time_count" readonly="1"/>
                                </group>
                                <group>
                                    <field name="total_hours" readonly="1"/>
                                    <field name="last_work_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                            <field name="description"/>
                        </page>
                    </notebook>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_worker_search" model="ir.ui.view">
        <field name="name">gest_agri.worker.search</field>
        <field name="model">gest_agri.worker</field>
        <field name="arch" type="xml">
            <search string="Travailleurs">
                <field name="name"/>
                <field name="firstname"/>
                <field name="reference"/>
                <field name="farm_id"/>
                <field name="function"/>
                <filter string="Actifs" name="active" domain="[('state','=','active')]"/>
                <filter string="Suspendus" name="suspended" domain="[('state','=','suspended')]"/>
                <filter string="Sortis" name="exited" domain="[('state','=','exited')]"/>
                <filter string="Archivés" name="archived" domain="[('active','=',False)]"/>
                <separator/>
                <group>
                    <filter string="Exploitation" name="group_farm" context="{'group_by':'farm_id'}"/>
                    <filter string="État" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Équipe" name="group_team" context="{'group_by':'team_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_worker" model="ir.actions.act_window">
        <field name="name">Travailleurs</field>
        <field name="res_model">gest_agri.worker</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gest_agri_worker"
              name="Travailleurs"
              parent="menu_gestion_agricole_personnel"
              action="action_gest_agri_worker"
              sequence="10"/>

    <!-- ============================================================ -->
    <!-- ÉQUIPES -->
    <!-- ============================================================ -->
    <record id="view_gest_agri_team_list" model="ir.ui.view">
        <field name="name">gest_agri.team.list</field>
        <field name="model">gest_agri.team</field>
        <field name="arch" type="xml">
            <list string="Équipes">
                <field name="reference"/>
                <field name="name"/>
                <field name="farm_id"/>
                <field name="leader_id"/>
                <field name="member_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_team_form" model="ir.ui.view">
        <field name="name">gest_agri.team.form</field>
        <field name="model">gest_agri.team</field>
        <field name="arch" type="xml">
            <form string="Équipe agricole">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="assignment_count" widget="statinfo" string="Affectations"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Nom de l'équipe"/>
                        <h1><field name="name"/></h1>
                        <h2><field name="reference" readonly="1"/></h2>
                    </div>
                    <notebook>
                        <page string="Informations" name="info">
                            <group>
                                <group>
                                    <field name="farm_id"/>
                                    <field name="site_id"/>
                                    <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                                </group>
                                <group>
                                    <field name="leader_id"/>
                                    <field name="active"/>
                                </group>
                            </group>
                            <group>
                                <field name="description"/>
                            </group>
                        </page>
                        <page string="Membres" name="members">
                            <field name="member_ids"/>
                        </page>
                        <page string="Statistiques" name="stats">
                            <group>
                                <group>
                                    <field name="member_count" readonly="1"/>
                                    <field name="assignment_count" readonly="1"/>
                                </group>
                                <group>
                                    <field name="total_hours" readonly="1"/>
                                    <field name="last_activity_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_team_search" model="ir.ui.view">
        <field name="name">gest_agri.team.search</field>
        <field name="model">gest_agri.team</field>
        <field name="arch" type="xml">
            <search string="Équipes">
                <field name="name"/>
                <field name="reference"/>
                <field name="farm_id"/>
                <field name="leader_id"/>
                <filter string="Actives" name="active" domain="[('active','=',True)]"/>
                <filter string="Archivées" name="archived" domain="[('active','=',False)]"/>
                <separator/>
                <group>
                    <filter string="Exploitation" name="group_farm" context="{'group_by':'farm_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_team" model="ir.actions.act_window">
        <field name="name">Équipes</field>
        <field name="res_model">gest_agri.team</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gest_agri_team"
              name="Équipes"
              parent="menu_gestion_agricole_personnel"
              action="action_gest_agri_team"
              sequence="10"/>

    <!-- ============================================================ -->
    <!-- AFFECTATIONS -->
    <!-- ============================================================ -->
    <record id="view_gest_agri_work_assignment_list" model="ir.ui.view">
        <field name="name">gest_agri.work.assignment.list</field>
        <field name="model">gest_agri.work.assignment</field>
        <field name="arch" type="xml">
            <list string="Affectations">
                <field name="reference"/>
                <field name="name"/>
                <field name="farm_id"/>
                <field name="worker_id"/>
                <field name="team_id"/>
                <field name="work_type"/>
                <field name="planned_start"/>
                <field name="planned_end"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_work_assignment_form" model="ir.ui.view">
        <field name="name">gest_agri.work.assignment.form</field>
        <field name="model">gest_agri.work.assignment</field>
        <field name="arch" type="xml">
            <form string="Affectation de travail">
                <header>
                    <button name="action_plan" string="Planifier" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_start" string="Démarrer" type="object" invisible="state != 'planned'" class="btn-primary"/>
                    <button name="action_done" string="Terminer" type="object" invisible="state != 'in_progress'" class="btn-primary"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_times" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="time_count" widget="statinfo" string="Feuilles"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Intitulé"/>
                        <h1><field name="name"/></h1>
                        <h2><field name="reference" readonly="1"/></h2>
                    </div>
                    <notebook>
                        <page string="Informations" name="info">
                            <group>
                                <group>
                                    <field name="farm_id"/>
                                    <field name="site_id"/>
                                    <field name="plot_id"/>
                                    <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                                </group>
                                <group>
                                    <field name="worker_id"/>
                                    <field name="team_id"/>
                                    <field name="responsible_id"/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="work_type"/>
                                    <field name="priority"/>
                                </group>
                                <group>
                                    <field name="instructions"/>
                                </group>
                            </group>
                        </page>
                        <page string="Planification" name="planning">
                            <group>
                                <group>
                                    <field name="planned_start"/>
                                    <field name="planned_end"/>
                                    <field name="planned_duration" readonly="1"/>
                                </group>
                                <group>
                                    <field name="actual_duration" readonly="1"/>
                                    <field name="duration_variance" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Production végétale" name="production">
                            <group>
                                <field name="cycle_id"/>
                                <field name="intervention_id"/>
                            </group>
                        </page>
                        <page string="Feuilles de temps" name="times">
                            <field name="time_ids" context="{'default_assignment_id': id}">
                                <list create="false" edit="false">
                                    <field name="name"/>
                                    <field name="worker_id"/>
                                    <field name="work_date"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="net_duration"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                            <button name="action_view_times" type="object" class="btn btn-link" string="Ouvrir toutes les feuilles de temps"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="description"/>
                        </page>
                    </notebook>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_work_assignment_search" model="ir.ui.view">
        <field name="name">gest_agri.work.assignment.search</field>
        <field name="model">gest_agri.work.assignment</field>
        <field name="arch" type="xml">
            <search string="Affectations">
                <field name="name"/>
                <field name="reference"/>
                <field name="farm_id"/>
                <field name="worker_id"/>
                <field name="team_id"/>
                <field name="work_type"/>
                <filter string="Brouillons" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Planifiées" name="planned" domain="[('state','=','planned')]"/>
                <filter string="En cours" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Terminées" name="done" domain="[('state','=','done')]"/>
                <filter string="Annulées" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <group>
                    <filter string="Exploitation" name="group_farm" context="{'group_by':'farm_id'}"/>
                    <filter string="État" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Travailleur" name="group_worker" context="{'group_by':'worker_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_work_assignment" model="ir.actions.act_window">
        <field name="name">Affectations de travail</field>
        <field name="res_model">gest_agri.work.assignment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gest_agri_work_assignment"
              name="Affectations"
              parent="menu_gestion_agricole_personnel"
              action="action_gest_agri_work_assignment"
              sequence="20"/>

    <!-- ============================================================ -->
    <!-- TEMPS DE TRAVAIL -->
    <!-- ============================================================ -->
    <record id="view_gest_agri_work_time_list" model="ir.ui.view">
        <field name="name">gest_agri.work.time.list</field>
        <field name="model">gest_agri.work.time</field>
        <field name="arch" type="xml">
            <list string="Feuilles de temps">
                <field name="name"/>
                <field name="worker_id"/>
                <field name="assignment_id"/>
                <field name="work_date"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="net_duration"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_work_time_form" model="ir.ui.view">
        <field name="name">gest_agri.work.time.form</field>
        <field name="model">gest_agri.work.time</field>
        <field name="arch" type="xml">
            <form string="Feuille de temps">
                <header>
                    <button name="action_validate" string="Valider" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Référence"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="assignment_id"/>
                            <field name="worker_id"/>
                            <field name="farm_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="work_date"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="break_duration"/>
                            <field name="duration" readonly="1"/>
                            <field name="net_duration" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_work_time_search" model="ir.ui.view">
        <field name="name">gest_agri.work.time.search</field>
        <field name="model">gest_agri.work.time</field>
        <field name="arch" type="xml">
            <search string="Feuilles de temps">
                <field name="name"/>
                <field name="worker_id"/>
                <field name="assignment_id"/>
                <filter string="Brouillons" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Validées" name="validated" domain="[('state','=','validated')]"/>
                <filter string="Annulées" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <group>
                    <filter string="Travailleur" name="group_worker" context="{'group_by':'worker_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'work_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_work_time" model="ir.actions.act_window">
        <field name="name">Feuilles de temps</field>
        <field name="res_model">gest_agri.work.time</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gest_agri_work_time"
              name="Temps de travail"
              parent="menu_gestion_agricole_personnel"
              action="action_gest_agri_work_time"
              sequence="30"/>
</odoo>