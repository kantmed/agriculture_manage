<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gest_agri_animal_list" model="ir.ui.view">
        <field name="name">gest_agri.animal.list</field>
        <field name="model">gest_agri.animal</field>
        <field name="arch" type="xml">
            <list string="Animaux">
                <field name="reference"/>
                <field name="name"/>
                <field name="official_id"/>
                <field name="species_id"/>
                <field name="breed_id"/>
                <field name="sex"/>
                <field name="farm_id"/>
                <field name="lot_id"/>
                <field name="state" widget="badge"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_animal_form" model="ir.ui.view">
        <field name="name">gest_agri.animal.form</field>
        <field name="model">gest_agri.animal</field>
        <field name="arch" type="xml">
            <form string="Animal">
                <header>
                    <button name="action_activate" string="Activer" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_sell" string="Vendre" type="object" invisible="state != 'active'"/>
                    <button name="action_die" string="Mort" type="object" invisible="state != 'active'"/>
                    <button name="action_retire" string="Retirer" type="object" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,sold,dead,retired"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Désignation"/>
                        <h1><field name="name"/></h1>
                        <h2><field name="reference" readonly="1"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="official_id"/>
                            <field name="species_id"/>
                            <field name="breed_id"/>
                            <field name="sex"/>
                        </group>
                        <group>
                            <field name="birth_date"/>
                            <field name="entry_date"/>
                            <field name="origin"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="farm_id"/>
                            <field name="site_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="lot_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_animal_search" model="ir.ui.view">
        <field name="name">gest_agri.animal.search</field>
        <field name="model">gest_agri.animal</field>
        <field name="arch" type="xml">
            <search string="Animaux">
                <field name="name"/>
                <field name="reference"/>
                <field name="official_id"/>
                <field name="species_id"/>
                <field name="breed_id"/>
                <field name="farm_id"/>
                <field name="lot_id"/>
                <filter string="Actifs" name="active" domain="[('state','=','active')]"/>
                <filter string="Archivés" name="archived" domain="[('active','=',False)]"/>
                <separator/>
                <group>
                    <filter string="Espèce" name="group_species" context="{'group_by':'species_id'}"/>
                    <filter string="Exploitation" name="group_farm" context="{'group_by':'farm_id'}"/>
                    <filter string="Lot" name="group_lot" context="{'group_by':'lot_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_animal" model="ir.actions.act_window">
        <field name="name">Animaux</field>
        <field name="res_model">gest_agri.animal</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gest_agri_animal"
              name="Animaux"
              parent="menu_gestion_agricole_elevage"
              action="action_gest_agri_animal"
              sequence="10"/>

    <!-- Lots -->
    <record id="view_gest_agri_animal_lot_list" model="ir.ui.view">
        <field name="name">gest_agri.animal.lot.list</field>
        <field name="model">gest_agri.animal.lot</field>
        <field name="arch" type="xml">
            <list string="Lots d'animaux">
                <field name="reference"/>
                <field name="name"/>
                <field name="species_id"/>
                <field name="breed_id"/>
                <field name="farm_id"/>
                <field name="member_count"/>
                <field name="state" widget="badge"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_gest_agri_animal_lot_form" model="ir.ui.view">
        <field name="name">gest_agri.animal.lot.form</field>
        <field name="model">gest_agri.animal.lot</field>
        <field name="arch" type="xml">
            <form string="Lot d'animaux">
                <header>
                    <button name="action_activate" string="Activer" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_close" string="Clôturer" type="object" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Désignation"/>
                        <h1><field name="name"/></h1>
                        <h2><field name="reference" readonly="1"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="species_id"/>
                            <field name="breed_id"/>
                            <field name="farm_id"/>
                            <field name="site_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="constitution_date"/>
                            <field name="member_count" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="member_ids"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gest_agri_animal_lot_search" model="ir.ui.view">
        <field name="name">gest_agri.animal.lot.search</field>
        <field name="model">gest_agri.animal.lot</field>
        <field name="arch" type="xml">
            <search string="Lots d'animaux">
                <field name="name"/>
                <field name="reference"/>
                <field name="species_id"/>
                <field name="farm_id"/>
                <filter string="Actifs" name="active" domain="[('state','=','active')]"/>
                <filter string="Archivés" name="archived" domain="[('active','=',False)]"/>
                <separator/>
                <group>
                    <filter string="Espèce" name="group_species" context="{'group_by':'species_id'}"/>
                    <filter string="Exploitation" name="group_farm" context="{'group_by':'farm_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gest_agri_animal_lot" model="ir.actions.act_window">
        <field name="name">Lots d'animaux</field>
        <field name="res_model">gest_agri.animal.lot</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gest_agri_animal_lot"
              name="Lots d'animaux"
              parent="menu_gestion_agricole_elevage"
              action="action_gest_agri_animal_lot"
              sequence="20"/>
</odoo>