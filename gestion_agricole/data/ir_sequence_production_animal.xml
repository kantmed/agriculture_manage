<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_gest_agri_milk_production" model="ir.sequence">
        <field name="name">Production laitière</field>
        <field name="code">gest_agri.milk.production</field>
        <field name="prefix">LAI/%(year)s/</field>
        <field name="padding">5</field>
        <field name="implementation">standard</field>
    </record>
    <record id="seq_gest_agri_milking_session" model="ir.sequence">
        <field name="name">Session de traite</field>
        <field name="code">gest_agri.milking.session</field>
        <field name="prefix">TRA/%(year)s/</field>
