        <field name="implementation">standard</field>
    </record>
    <record id="seq_gest_agri_milk_quality" model="ir.sequence">
        <field name="name">Qualité du lait</field>
        <field name="code">gest_agri.milk.quality</field>
        <field name="prefix">QLA/%(year)s/</field>
        <field name="padding">5</field>
        <field name="implementation">standard</field>
    </record>
    <record id="seq_gest_agri_animal_weight" model="ir.sequence">
        <field name="name">Pesée animale</field>
